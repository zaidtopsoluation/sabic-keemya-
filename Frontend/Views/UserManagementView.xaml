<UserControl x:Class="Keemya.Frontend.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Keemya.Frontend.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Navigation -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <Button Command="{Binding BackCommand}" HorizontalAlignment="Left" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" Foreground="{StaticResource TextPrimary}" Padding="15,8" Style="{StaticResource MaterialDesignFlatButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource BackToModules}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Page Header -->
        <Grid Grid.Row="1" Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource UserMgmtTitle}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,5" />
                <TextBlock Text="{DynamicResource UserMgmtDesc}" FontSize="14" Foreground="{StaticResource TextSecondary}" />
            </StackPanel>

            <Button Grid.Column="1" materialDesign:ButtonAssist.CornerRadius="5" Command="{Binding OpenAddUserPopupCommand}" Background="#2563EB" BorderBrush="Transparent" Foreground="White" Padding="15,10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AccountPlusOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Add User" VerticalAlignment="Center" FontWeight="Bold"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- KPI Summary Cards -->
        <UniformGrid Grid.Row="2" Columns="4" Margin="-10" Height="120">
            <!-- Total Users -->
            <Border Style="{StaticResource KpiCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Total Users" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
                    <materialDesign:PackIcon Grid.Row="0" Kind="AccountGroupOutline" Foreground="#3B82F6" HorizontalAlignment="Right" Width="20" Height="20"/>
                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock Text="{Binding TotalUsers}" FontSize="28" FontWeight="Bold" Foreground="#3B82F6" />
                        <TextBlock Text="Total registered users" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Administrators -->
            <Border Style="{StaticResource KpiCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Administrators" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
                    <materialDesign:PackIcon Grid.Row="0" Kind="ShieldAlertOutline" Foreground="#EF4444" HorizontalAlignment="Right" Width="20" Height="20"/>
                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock Text="{Binding Administrators}" FontSize="28" FontWeight="Bold" Foreground="#EF4444" />
                        <TextBlock Text="Users with admin privileges" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Operators -->
            <Border Style="{StaticResource KpiCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Operators" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
                    <materialDesign:PackIcon Grid.Row="0" Kind="AccountOutline" Foreground="#3B82F6" HorizontalAlignment="Right" Width="20" Height="20"/>
                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock Text="{Binding Operators}" FontSize="28" FontWeight="Bold" Foreground="#3B82F6" />
                        <TextBlock Text="Users with operator role" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Active Users -->
            <Border Style="{StaticResource KpiCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Active Users" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
                    <materialDesign:PackIcon Grid.Row="0" Kind="AccountCheckOutline" Foreground="#10B981" HorizontalAlignment="Right" Width="20" Height="20"/>
                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock Text="{Binding ActiveUsers}" FontSize="28" FontWeight="Bold" Foreground="#10B981" />
                        <TextBlock Text="Currently active users" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Data Table Container -->
        <Border Grid.Row="3" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Margin="0,20,0,0" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Table Header info -->
                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="System Users" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="View and manage user accounts, assigned roles, and access status." FontSize="12" Foreground="{StaticResource TextSecondary}" />
                </StackPanel>

                <!-- Search and Controls -->
                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Background="{StaticResource AppBackground}" Padding="10,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="Search" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Foreground="{StaticResource TextPrimary}" Background="Transparent" BorderThickness="0" materialDesign:HintAssist.Hint="{DynamicResource SearchUsersPlaceholder}" materialDesign:HintAssist.Foreground="{StaticResource TextSecondary}" CaretBrush="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Button Grid.Column="2" Background="Transparent" BorderBrush="{StaticResource CardBorder}" Foreground="{StaticResource TextPrimary}" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Tune" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="View" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- DataGrid -->
                <DataGrid Grid.Row="2" ItemsSource="{Binding Users}" AutoGenerateColumns="False" 
                          Background="Transparent" BorderThickness="0" GridLinesVisibility="None"
                          RowBackground="Transparent" RowHeaderWidth="0" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                          Foreground="{StaticResource TextPrimary}">
                    
                    <!-- Table Header Style -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="10" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
                            <Setter Property="Padding" Value="5" />
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <!-- User Column -->
                        <DataGridTemplateColumn Header="{DynamicResource ColUsername}" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource AppBackground}" Margin="0,0,10,0">
                                            <materialDesign:PackIcon Kind="AccountOutline" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Username}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Role Column -->
                        <DataGridTemplateColumn Header="{DynamicResource ColRole}" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Background="#DBEAFE" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Role}" Foreground="#1E40AF" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Status Column -->
                        <DataGridTemplateColumn Header="{DynamicResource ColStatus}" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Background="#D1FAE5" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Status}" Foreground="#065F46" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Last Login -->
                        <DataGridTextColumn Header="Last Login" Binding="{Binding LastLogin}" Width="150" Foreground="{StaticResource TextSecondary}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="10,0,0,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Created -->
                        <DataGridTextColumn Header="Created" Binding="{Binding Created}" Width="150" Foreground="{StaticResource TextSecondary}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="10,0,0,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Temporary Password -->
                        <DataGridTextColumn Header="{DynamicResource ColTempPassword}" Binding="{Binding TemporaryPassword}" Width="150" Foreground="{StaticResource TextSecondary}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="10,0,0,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Actions Column -->
                        <DataGridTemplateColumn Header="{DynamicResource ColActions}" Width="120">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Padding" Value="10" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Command="{Binding DataContext.OpenEditUserPopupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Width="32" Height="32" Background="Transparent" BorderBrush="{StaticResource CardBorder}" Padding="0" Margin="0,0,5,0" Style="{StaticResource MaterialDesignIconButton}">
                                            <materialDesign:PackIcon Kind="PencilOutline" Width="16" Height="16" Foreground="{StaticResource TextSecondary}" />
                                        </Button>
                                        <Button Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Width="32" Height="32" Background="Transparent" BorderBrush="{StaticResource CardBorder}" Padding="0" Style="{StaticResource MaterialDesignIconButton}">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16" Foreground="#EF4444" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Footer Pagination -->
                <Grid Grid.Row="3" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="0 of 1 row(s) selected" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="Rows per page" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox SelectedIndex="0" Foreground="{StaticResource TextPrimary}" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" Width="60" Margin="0,0,30,0">
                            <ComboBoxItem Content="10" />
                            <ComboBoxItem Content="20" />
                            <ComboBoxItem Content="50" />
                        </ComboBox>
                        
                        <TextBlock Text="Page 1 of 1" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,20,0" />
                        
                        <Button Width="32" Height="32" Background="Transparent" BorderBrush="{StaticResource CardBorder}" Style="{StaticResource MaterialDesignIconButton}" Margin="0,0,5,0">
                            <materialDesign:PackIcon Kind="ChevronDoubleLeft" Width="16" Height="16" Foreground="{StaticResource TextSecondary}" />
                        </Button>
                        <Button Width="32" Height="32" Background="Transparent" BorderBrush="{StaticResource CardBorder}" Style="{StaticResource MaterialDesignIconButton}" Margin="0,0,5,0">
                            <materialDesign:PackIcon Kind="ChevronLeft" Width="16" Height="16" Foreground="{StaticResource TextSecondary}" />
                        </Button>
                        <Button Width="32" Height="32" Background="Transparent" BorderBrush="{StaticResource CardBorder}" Style="{StaticResource MaterialDesignIconButton}" Margin="0,0,5,0">
                            <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16" Foreground="{StaticResource TextSecondary}" />
                        </Button>
                        <Button Width="32" Height="32" Background="Transparent" BorderBrush="{StaticResource CardBorder}" Style="{StaticResource MaterialDesignIconButton}">
                            <materialDesign:PackIcon Kind="ChevronDoubleRight" Width="16" Height="16" Foreground="{StaticResource TextSecondary}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Modal Popup Overlay for Adding User -->
        <Grid Grid.Row="0" Grid.RowSpan="4" 
              Visibility="{Binding IsAddUserPopupOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            
            <!-- Backdrop -->
            <Border Background="#80000000" Cursor="Arrow">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseAddUserPopupCommand}"/>
                </Border.InputBindings>
            </Border>
            
            <Border Width="450" Height="420" CornerRadius="12" Background="{StaticResource CardBackground}" 
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="25"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.5" Color="Black" />
                </Border.Effect>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="{Binding PopupTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding PopupSubtitle}" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>

                    <Button Grid.Row="0" Command="{Binding CloseAddUserPopupCommand}" Background="Transparent" BorderBrush="Transparent" Padding="0" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource MaterialDesignIconButton}" Panel.ZIndex="10">
                        <materialDesign:PackIcon Kind="Close" Foreground="{StaticResource TextSecondary}" Width="20" Height="20" />
                    </Button>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="{Binding PopupErrorMessage}" Foreground="#EF4444" FontSize="12" Margin="0,0,0,10" 
                                   Visibility="{Binding HasPopupError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <TextBlock Text="{DynamicResource Username}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Background="{StaticResource AppBackground}" Padding="10,5" Margin="0,0,0,15">
                            <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsEditMode}" Foreground="{StaticResource TextPrimary}" Background="Transparent" BorderThickness="0" materialDesign:HintAssist.Hint="Enter username" materialDesign:HintAssist.Foreground="{StaticResource TextSecondary}" CaretBrush="{StaticResource TextPrimary}" />
                        </Border>

                        <TextBlock Text="{DynamicResource ColRole}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Background="{StaticResource AppBackground}" Padding="10,5" Margin="0,0,0,15">
                            <ComboBox ItemsSource="{Binding RoleList}" SelectedItem="{Binding SelectedRole}" Foreground="{StaticResource TextPrimary}" Background="Transparent" BorderThickness="0" />
                        </Border>

                        <TextBlock Text="{DynamicResource ColStatus}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Background="{StaticResource AppBackground}" Padding="10,5">
                            <ComboBox ItemsSource="{Binding StatusList}" SelectedItem="{Binding SelectedStatus}" Foreground="{StaticResource TextPrimary}" Background="Transparent" BorderThickness="0" />
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{DynamicResource Save}" Command="{Binding SaveUserCommand}" Background="#6366F1" BorderBrush="Transparent" Foreground="White" FontWeight="Bold" Margin="0,0,10,0" Height="40" materialDesign:ButtonAssist.CornerRadius="5" />
                        <Button Grid.Column="1" Content="{DynamicResource Cancel}" Command="{Binding CloseAddUserPopupCommand}" Background="Transparent" BorderBrush="{StaticResource CardBorder}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" Height="40" materialDesign:ButtonAssist.CornerRadius="5" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
