<UserControl x:Class="Keemya.Frontend.Views.ZoneManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Keemya.Frontend.Views"
             xmlns:viewmodels="clr-namespace:Keemya.Frontend.ViewModels"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="1366">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Back button -->
            <RowDefinition Height="Auto" /> <!-- Title / Subtitle -->
            <RowDefinition Height="*" />    <!-- Main Cards Card -->
        </Grid.RowDefinitions>

        <!-- Row 0: Back Button -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <Button Command="{Binding BackCommand}" HorizontalAlignment="Left" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" Foreground="{StaticResource TextPrimary}" Padding="15,8" Style="{StaticResource MaterialDesignFlatButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource BackToModules}" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Row 1: Title and Actions -->
        <Grid Grid.Row="1" Margin="0,0,0,25">
            <StackPanel>
                <TextBlock Text="{DynamicResource ModZoneMgmt}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,5" />
                <TextBlock Text="{DynamicResource ModZoneMgmtDesc}" FontSize="14" Foreground="{StaticResource TextSecondary}" />
            </StackPanel>
        </Grid>

        <!-- Row 2: Central Grid Cards Card -->
        <Border Grid.Row="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="25">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Search and Add button -->
                    <RowDefinition Height="*" />    <!-- Scrollable Cards wrap -->
                </Grid.RowDefinitions>

                <!-- Row 0: Header with search and Add button -->
                <Grid Grid.Row="0" Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{DynamicResource ModZoneMgmt}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Grid.Column="0" />

                    <!-- Search Input Box -->
                    <Border Grid.Column="1" Width="300" Height="40" Background="{StaticResource AppBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,0" Margin="0,0,15,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Search" Width="18" Height="18" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" CaretBrush="{StaticResource TextPrimary}" VerticalAlignment="Center" VerticalContentAlignment="Center" materialDesign:HintAssist.Hint="{DynamicResource SearchZonesPlaceholder}" materialDesign:HintAssist.Foreground="{StaticResource TextSecondary}"/>
                        </Grid>
                    </Border>

                    <!-- Add Zone button -->
                    <Button Grid.Column="2"
                            materialDesign:ButtonAssist.CornerRadius="5"
                            Command="{Binding OpenAddZonePopupCommand}" Background="#2563EB" BorderBrush="Transparent" Foreground="White" Padding="15,10" Height="40">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Add Zone" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Row 1: Scrollable grid of zone cards -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Zones}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Margin="0,-10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Zone Card -->
                                <Border Width="280" Height="180" Margin="0,10,20,10" CornerRadius="10" BorderThickness="1.5" Background="{Binding LightBackgroundTint}" BorderBrush="{Binding ColorHex}" Padding="18">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.25" Color="Black" />
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" /> <!-- Title & Description -->
                                            <RowDefinition Height="*" />    <!-- Online Devices stat -->
                                            <RowDefinition Height="Auto" /> <!-- Action buttons -->
                                        </Grid.RowDefinitions>

                                        <!-- Title -->
                                        <StackPanel Grid.Row="0">
                                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <materialDesign:PackIcon Kind="MapMarkerOutline" Width="14" Height="14" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Devices online count -->
                                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{DynamicResource DevicesLabel}" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding DevicesStatusText}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Text=" " />
                                                <TextBlock Text="{DynamicResource DevicesOnline}" FontSize="13" Foreground="{Binding ColorHex}" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource CardBorder}" Padding="0,10,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Edit button -->
                                                <Button Grid.Column="0" Command="{Binding DataContext.OpenEditZonePopupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Foreground="#2563EB" Padding="0" HorizontalAlignment="Left" Style="{StaticResource MaterialDesignFlatButton}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="PencilOutline" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{DynamicResource Edit}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- Delete button -->
                                                <Button Grid.Column="1" Command="{Binding DataContext.DeleteZoneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Foreground="#DC2626" Padding="0" HorizontalAlignment="Right" Style="{StaticResource MaterialDesignFlatButton}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="TrashCanOutline" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{DynamicResource Delete}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Modal Popup Overlay for Adding / Editing Zone (Group) -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="100"
              Visibility="{Binding IsAddZonePopupOpen, Converter={StaticResource BooleanToVisibilityConverter}}">

            <!-- Backdrop -->
            <Border Background="#80000000" Cursor="Arrow">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseAddZonePopupCommand}"/>
                </Border.InputBindings>
            </Border>

            <!-- Centered Modal Popup Card -->
            <Border Width="450" Height="480" CornerRadius="12" Background="{StaticResource CardBackground}" 
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="25"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.5" Color="Black" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Header -->
                        <RowDefinition Height="*" />    <!-- Input fields -->
                        <RowDefinition Height="Auto" /> <!-- Actions -->
                    </Grid.RowDefinitions>

                    <!-- Popup Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="{Binding PopupTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding PopupSubtitle}" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>

                    <!-- Close button in upper right -->
                    <Button Grid.Row="0" Command="{Binding CloseAddZonePopupCommand}" Background="Transparent" BorderBrush="Transparent" Padding="0" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource MaterialDesignIconButton}" Panel.ZIndex="10">
                        <materialDesign:PackIcon Kind="Close" Foreground="{StaticResource TextSecondary}" Width="20" Height="20" />
                    </Button>

                    <!-- Input Fields -->
                    <StackPanel Grid.Row="1">
                        <!-- Error Banner -->
                        <TextBlock Text="{Binding PopupErrorMessage}" Foreground="#EF4444" FontSize="12" Margin="0,0,0,10" 
                                   Visibility="{Binding HasPopupError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <!-- Group Name -->
                        <TextBlock Text="{DynamicResource GroupName}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Background="{StaticResource AppBackground}" Padding="10,5" Margin="0,0,15,0">
                            <TextBox Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}" Foreground="{StaticResource TextPrimary}" Background="Transparent" BorderThickness="0" CaretBrush="{StaticResource TextPrimary}" />
                        </Border>

                        <!-- Description -->
                        <TextBlock Text="{DynamicResource Description}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Background="{StaticResource AppBackground}" Padding="10,5" Margin="0,0,15,0">
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Foreground="{StaticResource TextPrimary}" Background="Transparent" BorderThickness="0" CaretBrush="{StaticResource TextPrimary}" />
                        </Border>

                        <!-- Color dropdown with colored dot templates -->
                        <TextBlock Text="{DynamicResource Color}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Background="{StaticResource AppBackground}" Padding="10,5" Margin="0,0,15,0">
                            <ComboBox ItemsSource="{Binding ColorOptions}" SelectedValuePath="Name" SelectedValue="{Binding SelectedColor}" Foreground="{StaticResource TextPrimary}" Background="Transparent" BorderThickness="0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <!-- Dot indicating color choice -->
                                            <Border Width="12" Height="12" CornerRadius="6" Background="{Binding Hex}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding LocalizedName}" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Border>

                        <!-- Shape dropdown -->
                        <TextBlock Text="{DynamicResource Shape}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Background="{StaticResource AppBackground}" Padding="10,5">
                            <ComboBox ItemsSource="{Binding ShapeOptions}" SelectedItem="{Binding SelectedShape}" Foreground="{StaticResource TextPrimary}" Background="Transparent" BorderThickness="0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource TextPrimary}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Border>
                    </StackPanel>

                    <!-- Save & Cancel Buttons -->
                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{DynamicResource Save}" Command="{Binding SaveZoneCommand}" Background="#6366F1" BorderBrush="Transparent" Foreground="White" FontWeight="Bold" Margin="0,0,10,0" Height="40" materialDesign:ButtonAssist.CornerRadius="5" />
                        <Button Grid.Column="1" Content="{DynamicResource Cancel}" Command="{Binding CloseAddZonePopupCommand}" Background="Transparent" BorderBrush="{StaticResource CardBorder}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" Height="40" materialDesign:ButtonAssist.CornerRadius="5" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
