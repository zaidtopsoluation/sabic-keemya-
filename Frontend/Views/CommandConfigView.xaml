<UserControl x:Class="Keemya.Frontend.Views.CommandConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1366">

    <UserControl.Resources>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="false" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="false" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="false">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border CornerRadius="3" Background="#475569" x:Name="thumbBorder"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="true">
                                                        <Setter TargetName="thumbBorder" Property="Background" Value="#64748B"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="Height" Value="Auto"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Back button -->
            <RowDefinition Height="Auto" /> <!-- Title -->
            <RowDefinition Height="*"    /> <!-- Content card -->
        </Grid.RowDefinitions>

        <!-- ── Row 0: Back Button ─────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <Button Command="{Binding BackCommand}"
                    HorizontalAlignment="Left"
                    Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}"
                    Foreground="{StaticResource TextPrimary}" Padding="15,8"
                    Style="{StaticResource MaterialDesignFlatButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16"
                                            Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Back to Modules" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- ── Row 1: Page Title ──────────────────────────────────────── -->
        <Grid Grid.Row="1" Margin="0,0,0,25">
            <StackPanel>
                <TextBlock Text="Commands Configuration"
                           FontSize="28" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}" Margin="0,0,0,5"/>
                <TextBlock Text="Manage and customize available commands"
                           FontSize="14" Foreground="{StaticResource TextSecondary}"/>
            </StackPanel>
        </Grid>

        <!-- ── Row 2: Main Card ───────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBackground}"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                CornerRadius="8" Padding="25">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Search bar + stats + Add button -->
                    <RowDefinition Height="*"  /> <!-- Scrollable list -->
                </Grid.RowDefinitions>

                <!-- ── Toolbar: Stats + Search + Add ─────────────────── -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>  <!-- Stats badges -->
                        <ColumnDefinition Width="*"/>     <!-- spacer -->
                        <ColumnDefinition Width="300"/>   <!-- Search -->
                        <ColumnDefinition Width="Auto"/>  <!-- Add button -->
                    </Grid.ColumnDefinitions>

                    <!-- Stats badges -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Total -->
                        <Border Background="{StaticResource AppBackground}" CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TotalCount}" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}" Margin="0,0,4,0"/>
                                <TextBlock Text="total" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <!-- Enabled -->
                        <Border Background="#D1FAE5" CornerRadius="12" Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding EnabledCount}" FontWeight="Bold"
                                           Foreground="#065F46" Margin="0,0,4,0"/>
                                <TextBlock Text="enabled" Foreground="#065F46" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Search -->
                    <Border Grid.Column="2" Height="40"
                            Background="{StaticResource AppBackground}" BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="1" CornerRadius="6" Padding="12,0" Margin="0,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Search" Width="18" Height="18"
                                                     Foreground="{StaticResource TextSecondary}"
                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextPrimary}" CaretBrush="{StaticResource TextPrimary}"
                                     VerticalAlignment="Center" VerticalContentAlignment="Center"
                                     materialDesign:HintAssist.Hint="Search commands..."
                                     materialDesign:HintAssist.Foreground="{StaticResource TextSecondary}"/>
                        </Grid>
                    </Border>

                    <!-- Add Command button -->
                   <Button Grid.Column="3"
        Command="{Binding OpenAddCommandPopupCommand}"
        Background="#6366F1"
        BorderBrush="Transparent"
        Foreground="White"
        Padding="15,10"
        Height="40"
        materialDesign:ButtonAssist.CornerRadius="5"
        >

    <StackPanel Orientation="Horizontal">
        <materialDesign:PackIcon Kind="Plus"
                                 Width="18"
                                 Height="18"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"/>
        <TextBlock Text="Add Command"
                   VerticalAlignment="Center"
                   FontWeight="Bold"/>
    </StackPanel>
</Button>
                </Grid>

                <!-- ── Command List ────────────────────────────────────── -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CommandList"
                                  ItemsSource="{Binding Commands}"
                                  AllowDrop="True"
                                  Drop="CommandList_Drop"
                                  DragOver="CommandList_DragOver">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" CornerRadius="8"
                                        Background="{StaticResource AppBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                        Padding="20,14"
                                        Tag="{Binding}"
                                        AllowDrop="True"
                                        DragOver="CommandRow_DragOver"
                                        DragLeave="CommandRow_DragLeave"
                                        Drop="CommandRow_Drop">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>  <!-- Drag handle -->
                                            <ColumnDefinition Width="Auto"/>  <!-- Color dot -->
                                            <ColumnDefinition Width="*"/>     <!-- Name / desc / meta -->
                                            <ColumnDefinition Width="Auto"/>  <!-- Toggle + actions -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Drag Handle -->
                                        <materialDesign:PackIcon Grid.Column="0"
                                                                 Kind="DragVertical"
                                                                 Width="18" Height="18"
                                                                 Foreground="#4B5563"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,12,0"
                                                                 Cursor="SizeAll"
                                                                 Tag="DragHandle"
                                                                 PreviewMouseLeftButtonDown="DragHandle_MouseDown"
                                                                 PreviewMouseMove="DragHandle_MouseMove"
                                                                 PreviewMouseLeftButtonUp="DragHandle_MouseUp"/>

                                        <!-- Color dot -->
                                        <Border Grid.Column="1" Width="14" Height="14"
                                                CornerRadius="7"
                                                Background="{Binding ColorHex}"
                                                Margin="0,0,14,0" VerticalAlignment="Center"/>

                                        <!-- Command info -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="12" Foreground="{StaticResource TextSecondary}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,4"/>
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Duration pill -->
                                                <Border Background="{StaticResource CardBackground}" CornerRadius="4"
                                                        Padding="8,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding DurationDisplay}"
                                                               FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                </Border>
                                                <!-- CommandType pill -->
                                                <Border Background="{StaticResource CardBackground}" CornerRadius="4" Padding="8,2">
                                                    <TextBlock Text="{Binding CommandType}"
                                                               FontSize="11" FontFamily="Consolas"
                                                               Foreground="{StaticResource TextSecondary}"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Right side: Toggle + Edit + Delete -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                    VerticalAlignment="Center">

                                            <!-- Enabled toggle -->
                                            <ToggleButton
                                                IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                Command="{Binding DataContext.ToggleEnabledCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,12,0"
                                                Style="{StaticResource CleanSwitchStyle}" />

                                            <!-- Edit -->
                                            <Button Width="34" Height="34"
                                                    Command="{Binding DataContext.OpenEditCommandPopupCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}"
                                                    BorderThickness="1"
                                                    Margin="0,0,6,0" Padding="0"
                                                    Style="{StaticResource MaterialDesignIconButton}">
                                                <materialDesign:PackIcon Kind="PencilOutline"
                                                                         Width="16" Height="16"
                                                                         Foreground="#2563EB"/>
                                            </Button>
 
                                            <!-- Delete -->
                                            <Button Width="34" Height="34"
                                                    Command="{Binding DataContext.DeleteCommandCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}"
                                                    BorderThickness="1"
                                                    Padding="0"
                                                    Style="{StaticResource MaterialDesignIconButton}">
                                                <materialDesign:PackIcon Kind="TrashCanOutline"
                                                                         Width="16" Height="16"
                                                                         Foreground="#DC2626"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- Modal Popup Overlay                                           -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="100"
              Visibility="{Binding IsPopupOpen, Converter={StaticResource BooleanToVisibilityConverter}}">

            <!-- Backdrop -->
            <Border Background="#80000000" Cursor="Arrow">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ClosePopupCommand}"/>
                </Border.InputBindings>
            </Border>

            <!-- Popup Card -->
            <Border Width="480" CornerRadius="12"
                    Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="12" Opacity="0.5" Color="Black"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="*"  /> <!-- Fields -->
                        <RowDefinition Height="Auto"/> <!-- Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="{Binding PopupTitle}" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding PopupSubtitle}" FontSize="12"
                                       Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                        <Button Command="{Binding ClosePopupCommand}"
                                Background="Transparent" BorderBrush="Transparent"
                                Padding="0" Width="30" Height="30"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Style="{StaticResource MaterialDesignIconButton}">
                            <materialDesign:PackIcon Kind="Close" Foreground="{StaticResource TextSecondary}"
                                                     Width="20" Height="20"/>
                        </Button>
                    </Grid>

                    <!-- Fields -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="420">
                        <StackPanel>
                            <!-- Error -->
                            <TextBlock Text="{Binding PopupErrorMessage}"
                                       Foreground="#EF4444" FontSize="12" Margin="0,0,0,10"
                                       Visibility="{Binding HasPopupError,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <!-- Command Name -->
                            <TextBlock Text="Command Name *"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                    CornerRadius="6" Background="{StaticResource AppBackground}"
                                    Padding="10,8" Margin="0,0,0,14">
                                <TextBox Text="{Binding CommandName, UpdateSourceTrigger=PropertyChanged}"
                                         Foreground="{StaticResource TextPrimary}"
                                         Background="Transparent" BorderThickness="0"
                                         CaretBrush="{StaticResource TextPrimary}"
                                         materialDesign:HintAssist.Hint="e.g. Emergency Alert"
                                         materialDesign:HintAssist.Foreground="{StaticResource TextSecondary}"/>
                            </Border>

                            <!-- Description -->
                            <TextBlock Text="Description"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                    CornerRadius="6" Background="{StaticResource AppBackground}"
                                    Padding="10,8" Margin="0,0,0,14">
                                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                         Foreground="{StaticResource TextPrimary}"
                                         Background="Transparent" BorderThickness="0"
                                         CaretBrush="{StaticResource TextPrimary}"
                                         materialDesign:HintAssist.Hint="Describe what this command does..."
                                         materialDesign:HintAssist.Foreground="{StaticResource TextSecondary}"/>
                            </Border>

                            <!-- Command Type (Protocol dropdown) -->
                            <TextBlock Text="Command Type *"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                    CornerRadius="6" Background="{StaticResource AppBackground}"
                                    Padding="10,5" Margin="0,0,0,14">
                                <ComboBox ItemsSource="{Binding ProtocolCommands}"
                                          SelectedValuePath="Key"
                                          SelectedValue="{Binding SelectedCommandType}"
                                          Foreground="{StaticResource TextPrimary}"
                                          Background="Transparent" BorderThickness="0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Border>

                            <!-- Color -->
                            <TextBlock Text="Color"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                    CornerRadius="6" Background="{StaticResource AppBackground}"
                                    Padding="10,5" Margin="0,0,0,14">
                                <ComboBox ItemsSource="{Binding ColorOptions}"
                                          SelectedValuePath="Name"
                                          SelectedValue="{Binding SelectedColor}"
                                          Foreground="{StaticResource TextPrimary}"
                                          Background="Transparent" BorderThickness="0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="2">
                                                <Border Width="12" Height="12" CornerRadius="6"
                                                        Background="{Binding Hex}"
                                                        Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Border>

                            <!-- Audio File (Conditional on Custom) -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedCommandType}" Value="Custom">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Audio"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                        CornerRadius="6" Background="{StaticResource AppBackground}"
                                        Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="Choose File" 
                                                Command="{Binding BrowseAudioFileCommand}"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"
                                                Padding="10,8" Margin="0" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding SelectedAudioFilePath, TargetNullValue='No file chosen'}"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   VerticalAlignment="Center" Margin="5,0,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Duration -->
                            <TextBlock Text="Duration (seconds)"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                    CornerRadius="6" Background="{StaticResource AppBackground}"
                                    Padding="10,8" Margin="0,0,0,14">
                                <TextBox Text="{Binding Duration, UpdateSourceTrigger=PropertyChanged}"
                                         Foreground="{StaticResource TextPrimary}"
                                         Background="Transparent" BorderThickness="0" CaretBrush="{StaticResource TextPrimary}"/>
                            </Border>

                            <!-- Enable toggle -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <CheckBox IsChecked="{Binding IsCommandEnabled}"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="Enable this command"
                                           Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Save / Cancel -->
                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Save"
                                Command="{Binding SaveCommandCommand}"
                                Background="#6366F1" BorderBrush="Transparent"
                                Foreground="White" FontWeight="Bold"
                                Height="40" materialDesign:ButtonAssist.CornerRadius="5"
                                Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Content="Cancel"
                                Command="{Binding ClosePopupCommand}"
                                Background="Transparent"
                                BorderBrush="{StaticResource CardBorder}"
                                Foreground="{StaticResource TextPrimary}"
                                Height="40" materialDesign:ButtonAssist.CornerRadius="5"
                                FontWeight="Bold"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
