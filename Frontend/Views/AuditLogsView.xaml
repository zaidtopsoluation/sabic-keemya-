<UserControl x:Class="Keemya.Frontend.Views.AuditLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1200">

    <UserControl.Resources>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="false" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="false" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="false">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border CornerRadius="3" Background="#475569" x:Name="thumbBorder"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="true">
                                                        <Setter TargetName="thumbBorder" Property="Background" Value="#64748B"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="Height" Value="Auto"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
            <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <!-- Top Navigation -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <Button Command="{Binding NavigateBackCommand}" HorizontalAlignment="Left" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" Foreground="{StaticResource TextPrimary}" Padding="15,8" Style="{StaticResource MaterialDesignFlatButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource BackToModules}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Page Header -->
        <StackPanel Grid.Row="1" Margin="0,0,0,25">
            <TextBlock Text="{DynamicResource ModAuditLogs}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,5" />
            <TextBlock Text="{DynamicResource ModAuditLogsDesc}" FontSize="14" Foreground="{StaticResource TextSecondary}" />
        </StackPanel>

        <!-- KPI Summary Cards -->
        <UniformGrid Grid.Row="2" Columns="4" Margin="-10" Height="120">
            <!-- Total Logs -->
            <Border Style="{StaticResource KpiCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Total Logs" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
                    <materialDesign:PackIcon Grid.Row="0" Kind="FileDocumentOutline" Foreground="#3B82F6" HorizontalAlignment="Right" Width="18" Height="18"/>
                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock Text="{Binding TotalLogs}" FontSize="28" FontWeight="Bold" Foreground="#3B82F6" />
                        <TextBlock Text="All logs recorded" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Today -->
            <Border Style="{StaticResource KpiCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Today" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
                    <materialDesign:PackIcon Grid.Row="0" Kind="ClockOutline" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" Width="18" Height="18"/>
                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock Text="{Binding TodayLogs}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Text="Logs recorded today" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- This Week -->
            <Border Style="{StaticResource KpiCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="This Week" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
                    <materialDesign:PackIcon Grid.Row="0" Kind="CalendarWeekOutline" Foreground="#EAB308" HorizontalAlignment="Right" Width="18" Height="18"/>
                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock Text="{Binding ThisWeekLogs}" FontSize="28" FontWeight="Bold" Foreground="#EAB308" />
                        <TextBlock Text="Logs recorded this week" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Unique Users -->
            <Border Style="{StaticResource KpiCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Unique Users" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
                    <materialDesign:PackIcon Grid.Row="0" Kind="AccountGroupOutline" Foreground="#A855F7" HorizontalAlignment="Right" Width="18" Height="18"/>
                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock Text="{Binding UniqueUsers}" FontSize="28" FontWeight="Bold" Foreground="#A855F7" />
                        <TextBlock Text="Users who generated logs" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Filters & Data Table Container -->
        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Filters Section -->
            <Border Grid.Row="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <materialDesign:PackIcon Kind="FilterOutline" Foreground="{StaticResource TextPrimary}" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Filters" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1.5*" />
                        </Grid.ColumnDefinitions>

                        <!-- Search -->
                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                            <TextBlock Text="Search" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,5" />
                            <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Background="{StaticResource AppBackground}" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="Search" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Foreground="{StaticResource TextPrimary}" Background="Transparent" BorderThickness="0" materialDesign:HintAssist.Hint="Search logs..." materialDesign:HintAssist.Foreground="{StaticResource TextSecondary}" CaretBrush="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Module -->
                        <StackPanel Grid.Column="1" Margin="0,0,15,0">
                            <TextBlock Text="Module" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,5" />
                            <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Background="{StaticResource AppBackground}" Padding="10,5">
                                <ComboBox ItemsSource="{Binding ModulesList}" SelectedItem="{Binding SelectedModule}" Foreground="{StaticResource TextPrimary}" Background="Transparent" BorderThickness="0" />
                            </Border>
                        </StackPanel>

                        <!-- User -->
                        <StackPanel Grid.Column="2" Margin="0,0,15,0">
                            <TextBlock Text="User" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,5" />
                            <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Background="{StaticResource AppBackground}" Padding="10,5">
                                <ComboBox ItemsSource="{Binding UsersList}" SelectedItem="{Binding SelectedUser}" Foreground="{StaticResource TextPrimary}" Background="Transparent" BorderThickness="0" />
                            </Border>
                        </StackPanel>

                        <!-- Start Date -->
                        <StackPanel Grid.Column="3" Margin="0,0,15,0">
                            <TextBlock Text="Start Date" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,5" />
                            <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Background="{StaticResource AppBackground}" Padding="10,5">
                                <DatePicker SelectedDate="{Binding StartDate}" Foreground="{StaticResource TextPrimary}" Background="Transparent" BorderThickness="0" materialDesign:HintAssist.Hint="Start Date"/>
                            </Border>
                        </StackPanel>

                        <!-- End Date -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="End Date" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,5" />
                            <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Background="{StaticResource AppBackground}" Padding="10,5">
                                <DatePicker SelectedDate="{Binding EndDate}" Foreground="{StaticResource TextPrimary}" Background="Transparent" BorderThickness="0" materialDesign:HintAssist.Hint="End Date"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Data Table Container -->
            <Border Grid.Row="1" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Table Header & Controls -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Audit Trail" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding ExportCsvCommand}" Background="Transparent" BorderBrush="{StaticResource CardBorder}" Foreground="{StaticResource TextPrimary}" Padding="10,5" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileDocumentOutline" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Export CSV" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ExportPdfCommand}" Background="Transparent" BorderBrush="{StaticResource CardBorder}" Foreground="{StaticResource TextPrimary}" Padding="10,5">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FilePdfBox" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Export PDF" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Logs}" AutoGenerateColumns="False" 
                              Background="Transparent" BorderThickness="0" GridLinesVisibility="None"
                              RowBackground="Transparent" RowHeaderWidth="0" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                              Foreground="{StaticResource TextPrimary}">
                        
                        <!-- Table Header Style -->
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="10" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <!-- Actor -->
                            <DataGridTextColumn Header="Actor" Binding="{Binding Actor}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="10,0,0,0"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Action -->
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="10,0,0,0"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Description -->
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="10,0,0,0"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Module -->
                            <DataGridTextColumn Header="Module" Binding="{Binding Module}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="10,0,0,0"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Timestamp -->
                            <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="10,0,0,0"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Actions Column -->
                            <DataGridTemplateColumn Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Command="{Binding DataContext.OpenLogDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}"
                                                    Width="32" Height="32" Background="Transparent" BorderBrush="Transparent" Padding="0" Style="{StaticResource MaterialDesignIconButton}">
                                                <materialDesign:PackIcon Kind="EyeOutline" Width="18" Height="18" Foreground="{StaticResource TextSecondary}" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Footer Pagination -->
                    <Grid Grid.Row="2" Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding TotalRowsInfo}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="Rows per page" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox ItemsSource="{Binding ItemsPerPageOptions}" SelectedItem="{Binding ItemsPerPage}" Foreground="{StaticResource TextPrimary}" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" Width="60" Margin="0,0,30,0">
                            </ComboBox>
                            
                            <TextBlock Text="{Binding PaginationInfo}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,20,0" />
                            
                            <Button Command="{Binding FirstPageCommand}" IsEnabled="{Binding CanGoFirst}" Width="32" Height="32" Background="Transparent" BorderBrush="{StaticResource CardBorder}" Style="{StaticResource MaterialDesignIconButton}" Margin="0,0,5,0">
                                <materialDesign:PackIcon Kind="ChevronDoubleLeft" Width="16" Height="16" Foreground="{StaticResource TextSecondary}" />
                            </Button>
                            <Button Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}" Width="32" Height="32" Background="Transparent" BorderBrush="{StaticResource CardBorder}" Style="{StaticResource MaterialDesignIconButton}" Margin="0,0,5,0">
                                <materialDesign:PackIcon Kind="ChevronLeft" Width="16" Height="16" Foreground="{StaticResource TextSecondary}" />
                            </Button>
                            <Button Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}" Width="32" Height="32" Background="Transparent" BorderBrush="{StaticResource CardBorder}" Style="{StaticResource MaterialDesignIconButton}" Margin="0,0,5,0">
                                <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16" Foreground="{StaticResource TextSecondary}" />
                            </Button>
                            <Button Command="{Binding LastPageCommand}" IsEnabled="{Binding CanGoLast}" Width="32" Height="32" Background="Transparent" BorderBrush="{StaticResource CardBorder}" Style="{StaticResource MaterialDesignIconButton}">
                                <materialDesign:PackIcon Kind="ChevronDoubleRight" Width="16" Height="16" Foreground="{StaticResource TextSecondary}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        </Grid>
    </ScrollViewer>

        <!-- Modal Popup Overlay for Log Details -->
        <Grid Visibility="{Binding IsLogDetailsPopupOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            
            <!-- Backdrop -->
            <Border Background="#80000000" Cursor="Arrow">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseLogDetailsCommand}"/>
                </Border.InputBindings>
            </Border>
            
            <!-- Modal Content -->
            <Border Width="450" Height="400" CornerRadius="12" Background="{StaticResource CardBackground}" 
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="25"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.5" Color="Black" />
                </Border.Effect>
                
                <Grid DataContext="{Binding SelectedLog}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Audit Log Details" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4" />
                        <TextBlock Text="Detailed information about this audit log entry" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>

                    <Button Grid.Row="0" Command="{Binding DataContext.CloseLogDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Background="Transparent" BorderBrush="Transparent" Padding="0" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource MaterialDesignIconButton}" Panel.ZIndex="10">
                        <materialDesign:PackIcon Kind="Close" Foreground="{StaticResource TextSecondary}" Width="20" Height="20" />
                    </Button>

                    <!-- Grid of details -->
                    <StackPanel Grid.Row="1">
                        <Grid Margin="0,0,0,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,20">
                                <TextBlock Text="Log ID" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,5" />
                                <TextBlock Text="{Binding Id}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,20">
                                <TextBlock Text="Timestamp" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,5" />
                                <TextBlock Text="{Binding Timestamp}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,20">
                                <TextBlock Text="User" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,5" />
                                <TextBlock Text="{Binding Actor}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,20">
                                <TextBlock Text="Module" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,5" />
                                <TextBlock Text="{Binding Module}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Action" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,5" />
                                <Border Background="{StaticResource AppBackground}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Action}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="11" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Entity" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,5" />
                                <TextBlock Text="{Binding EntityId}" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" FontSize="11" />
                            </StackPanel>
                        </Grid>

                        <StackPanel>
                            <TextBlock Text="Description" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,5" />
                            <Border Background="{StaticResource AppBackground}" CornerRadius="6" Padding="15">
                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
