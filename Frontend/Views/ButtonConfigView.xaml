<UserControl x:Class="Keemya.Frontend.Views.ButtonConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1366">

    <Grid Margin="25,0,25,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Back -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <Button Command="{Binding BackCommand}" materialDesign:ButtonAssist.CornerRadius="5"
                    HorizontalAlignment="Left" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" Foreground="{StaticResource TextPrimary}" Padding="15,8" Style="{StaticResource MaterialDesignFlatButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Back to Modules" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Title -->
        <StackPanel Grid.Row="1" Margin="0,0,0,25">
            <TextBlock Text="{DynamicResource ModButtonConfig}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,5" />
            <TextBlock Text="{DynamicResource ModButtonConfigDesc}" FontSize="14" Foreground="{StaticResource TextSecondary}" />
        </StackPanel>

        <!-- Button list -->
        <Border Grid.Row="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="25">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Activation Buttons" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="Place them with Button Layout. New buttons go to the first free spot. Changes appear the next time Command Center and Map are opened." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding OpenLayoutCommand}" materialDesign:ButtonAssist.CornerRadius="5" Margin="0,0,10,0"
                                Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" Foreground="{StaticResource TextPrimary}" Padding="15,10" Height="40">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewGridOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Button Layout" VerticalAlignment="Center" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenAddCommand}" materialDesign:ButtonAssist.CornerRadius="5"
                                Background="#2563EB" BorderBrush="Transparent" Foreground="White" Padding="15,10" Height="40">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Add Button" VerticalAlignment="Center" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Buttons}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="70" Background="{StaticResource AppBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" Padding="15,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Button preview -->
                                        <Border Grid.Column="0" Width="140" Height="46" CornerRadius="4" Background="{Binding ColorHex}" VerticalAlignment="Center" Margin="0,0,15,0">
                                            <TextBlock Text="{Binding Name}" Foreground="{Binding TextColorHex}" FontWeight="Bold" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,0" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <Border CornerRadius="10" Background="{StaticResource CardBackground}" Padding="8,2" VerticalAlignment="Center">
                                                    <TextBlock FontSize="11" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="ENABLED" />
                                                                <Setter Property="Foreground" Value="#10B981" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                        <Setter Property="Text" Value="HIDDEN" />
                                                                        <Setter Property="Foreground" Value="#94A3B8" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Move up" Width="36" Height="36" Padding="0" Margin="0,0,8,0" Style="{StaticResource MaterialDesignIconButton}">
                                                <materialDesign:PackIcon Kind="ArrowUp" Width="18" Height="18" Foreground="{StaticResource TextSecondary}" />
                                            </Button>
                                            <Button Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Move down" Width="36" Height="36" Padding="0" Margin="0,0,8,0" Style="{StaticResource MaterialDesignIconButton}">
                                                <materialDesign:PackIcon Kind="ArrowDown" Width="18" Height="18" Foreground="{StaticResource TextSecondary}" />
                                            </Button>
                                            <Button Command="{Binding DataContext.OpenEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Edit" Width="36" Height="36" Padding="0" Margin="0,0,8,0" Style="{StaticResource MaterialDesignIconButton}">
                                                <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18" Foreground="#60A5FA" />
                                            </Button>
                                            <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Delete" Width="36" Height="36" Padding="0" Style="{StaticResource MaterialDesignIconButton}">
                                                <materialDesign:PackIcon Kind="TrashCan" Width="18" Height="18" Foreground="#F87171" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Add / Edit popup -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="100"
              Visibility="{Binding IsPopupOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#80000000">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ClosePopupCommand}" />
                </Border.InputBindings>
            </Border>

            <Border Width="520" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="25" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding PopupTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,20" />

                    <TextBlock Text="Button label" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding ButtonLabel, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" Foreground="{StaticResource TextPrimary}" materialDesign:HintAssist.Hint="e.g. FIRE ALARM" Margin="0,0,0,16" />

                    <TextBlock Text="Siren tone / command" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding Tones}" SelectedItem="{Binding SelectedTone}" DisplayMemberPath="Name" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16" />

                    <!-- Pre-recorded message: the server plays pre-tone + this file to the sirens -->
                    <Grid Margin="0,0,0,16" Visibility="{Binding IsPreRecorded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Command="{Binding UploadAudioCommand}" Background="#2563EB" BorderBrush="Transparent" Foreground="White" materialDesign:ButtonAssist.CornerRadius="5" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Upload" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Upload audio (mp3 / wav)" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="1" Text="{Binding AudioName, TargetNullValue='No file uploaded'}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
                    </Grid>

                    <TextBlock Text="Color (pick a quick color, or drag in the picker for any shade)" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <ItemsControl ItemsSource="{Binding PresetColors}" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                        Width="28" Height="28" Margin="0,0,6,6" Padding="0" Background="{Binding}" BorderBrush="{StaticResource CardBorder}"
                                        Style="{StaticResource MaterialDesignFlatButton}" materialDesign:ButtonAssist.CornerRadius="14" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                            <!-- Visual picker: hue slider + shade area, no hex knowledge needed -->
                            <materialDesign:ColorPicker Color="{Binding PickerColor, Mode=TwoWay}" Height="130" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Preview" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                            <Border Width="140" Height="75" CornerRadius="4" Background="{Binding PreviewBackground}">
                                <TextBlock Text="{Binding PreviewText}" Foreground="{Binding PreviewForeground}" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,0" />
                            </Border>                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Run time (seconds, 0 = manual stop)" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" Foreground="{StaticResource TextPrimary}" Width="120" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,20,0">
                            <TextBlock Text="Size" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding ButtonSizes}" SelectedItem="{Binding ButtonSize}" Width="100" Foreground="{StaticResource TextPrimary}" />
                        </StackPanel>
                        <CheckBox Grid.Column="2" IsChecked="{Binding IsButtonEnabled}" Content="Show on screens" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Bottom" />
                    </Grid>

                    <TextBlock Text="{Binding PopupErrorMessage}" Foreground="#EF4444" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding ClosePopupCommand}" Content="Cancel" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,0" />
                        <Button Command="{Binding SaveCommand}" Content="Save" Background="#2563EB" BorderBrush="Transparent" Foreground="White" materialDesign:ButtonAssist.CornerRadius="5" Padding="20,8" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Button Layout editor: drag buttons, they snap to the grid (same idea as GV Core's layout screen) -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="100"
              Visibility="{Binding IsLayoutOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#80000000" />
            <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="25" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Button Layout" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="Drag the buttons to where they should be in Command Center. They snap to the grid." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,15" />

                    <!-- Same size as the Command Center button area -->
                    <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Background="{StaticResource AppBackground}" HorizontalAlignment="Left">
                        <ItemsControl ItemsSource="{Binding LayoutItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Width="{Binding DataContext.LayoutWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Height="{Binding DataContext.LayoutHeight, RelativeSource={RelativeSource AncestorType=UserControl}}" ClipToBounds="True" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Thumb Width="{Binding Button.ButtonWidth}" Height="{Binding Button.ButtonHeight}" Cursor="SizeAll"
                                           DragStarted="LayoutThumb_DragStarted" DragDelta="LayoutThumb_DragDelta">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{Binding Button.ColorHex}" BorderBrush="White" BorderThickness="1">
                                                    <TextBlock Text="{Binding Button.Name}" Foreground="{Binding Button.TextColorHex}" FontWeight="Bold" FontSize="{Binding Button.ButtonFontSize}"
                                                               TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,0" />
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Grid Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Columns" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding LayoutColumns, UpdateSourceTrigger=PropertyChanged}" MaxLength="1" Width="30" Foreground="{StaticResource TextPrimary}" Margin="0,0,10,0" />
                            <Button Command="{Binding AutoArrangeLayoutCommand}" Content="Auto-arrange" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#60A5FA" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding CloseLayoutCommand}" Content="Cancel" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,0" />
                            <Button Command="{Binding SaveLayoutCommand}" Content="Save Layout" Background="#2563EB" BorderBrush="Transparent" Foreground="White" materialDesign:ButtonAssist.CornerRadius="5" Padding="20,8" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
