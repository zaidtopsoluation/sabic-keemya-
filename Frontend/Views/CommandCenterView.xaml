<UserControl x:Class="Keemya.Frontend.Views.CommandCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:Keemya.Frontend.ViewModels"
             xmlns:views="clr-namespace:Keemya.Frontend.Views"
             mc:Ignorable="d" d:DesignHeight="768" d:DesignWidth="1366">

    <UserControl.Resources>
        <!-- Log Color Converter -->
        <views:LogColorConverter x:Key="LogColorConverter"/>

        <!-- Converter for bool → Visibility -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Custom Row Button Template to avoid default WPF styling/squashing -->
        <Style x:Key="ClickableRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat square button style with white border and NO drop shadow -->
        <Style x:Key="FlatTouchButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat square toggle button style with white border, NO drop shadow, and yellow highlight border when selected -->
        <Style x:Key="FlatTouchToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFFF00"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#5A5A5A">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>      <!-- Column 0: Left panel content -->
            <ColumnDefinition Width="260"/>    <!-- Column 1: STATUS sidebar -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Back Button -->
            <RowDefinition Height="*"/>    <!-- Row 1: Main Touch Console Buttons Grid -->
            <RowDefinition Height="160"/>  <!-- Row 2: Live Logs Terminal -->
        </Grid.RowDefinitions>

        <!-- ── ROW 0: Back to Modules Button ────────────────────────────── -->
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="10,10,10,5">
            <Button Command="{Binding BackCommand}" HorizontalAlignment="Left"
                    Background="#333333" BorderBrush="White" BorderThickness="1"
                    Foreground="White" Padding="15,6" Height="36"
                    Style="{StaticResource MaterialDesignFlatButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16"
                                            Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Back to Modules" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- ── ROW 1: Main Touch Console Buttons Grid (LEFT PANEL) ──────── -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Alarm Grid (Top) -->
            <Grid Grid.Row="0" Margin="20,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Row 0 -->
                <!-- FIRE ALARM -->
                <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource FlatTouchButtonStyle}" Command="{Binding SelectFireAlarmCommand}" Margin="8" Width="140" Height="75" Background="#A72A2A">
                    <TextBlock Text="FIRE ALARM" Foreground="White" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>

                <!-- GAS ALARM -->
                <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource FlatTouchButtonStyle}" Command="{Binding SelectGasAlarmCommand}" Margin="8" Width="140" Height="75" Background="#E68A00">
                    <TextBlock Text="GAS ALARM" Foreground="White" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>

                <!-- ALL CLEAR ALARM -->
                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource FlatTouchButtonStyle}" Command="{Binding SelectAllClearAlarmCommand}" Margin="8" Width="140" Height="75" Background="#2A75B3">
                    <TextBlock Text="ALL CLEAR ALARM" Foreground="White" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>

                <!-- Row 1 -->
                <!-- RESET ALARM -->
                <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource FlatTouchButtonStyle}" Command="{Binding SelectResetAlarmCommand}" Margin="8" Width="140" Height="75" Background="#E6D900">
                    <TextBlock Text="RESET ALARM" Foreground="Black" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>

                <!-- PUBLIC ADDRESS -->
                <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource FlatTouchButtonStyle}" Command="{Binding SelectPublicAddressCommand}" Margin="8" Width="140" Height="75" Background="#3B82F6">
                    <TextBlock Text="PUBLIC ADDRESS" Foreground="White" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>

                <!-- ATTENTION -->
                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource FlatTouchButtonStyle}" Command="{Binding SelectAttentionCommand}" Margin="8" Width="140" Height="75" Background="#5C2AB3">
                    <TextBlock Text="ATTENTION" Foreground="White" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- Station Grid (Bottom) -->
            <Grid Grid.Row="2" Margin="20,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Row 0 -->
                <!-- Admin ECC -->
                <ToggleButton Grid.Row="0" Grid.Column="0" Style="{StaticResource FlatTouchToggleButtonStyle}" IsChecked="{Binding IsAdminEccSelected}" Command="{Binding SelectAdminEccCommand}" Margin="8" Width="140" Height="75" Background="#4A6B4A">
                    <TextBlock Text="Admin ECC" Foreground="White" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </ToggleButton>

                <!-- PCB/ECS -->
                <ToggleButton Grid.Row="0" Grid.Column="1" Style="{StaticResource FlatTouchToggleButtonStyle}" IsChecked="{Binding IsPcbEcsSelected}" Command="{Binding SelectPcbEcsCommand}" Margin="8" Width="140" Height="75" Background="#4A6B4A">
                    <TextBlock Text="PCB/ECS" Foreground="White" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </ToggleButton>

                <!-- RCB/ECS -->
                <ToggleButton Grid.Row="0" Grid.Column="2" Style="{StaticResource FlatTouchToggleButtonStyle}" IsChecked="{Binding IsRcbEcsSelected}" Command="{Binding SelectRcbEcsCommand}" Margin="8" Width="140" Height="75" Background="#4A6B4A">
                    <TextBlock Text="RCB/ECS" Foreground="White" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </ToggleButton>

                <!-- Row 1 -->
                <!-- PCB-Controller -->
                <ToggleButton Grid.Row="1" Grid.Column="1" Style="{StaticResource FlatTouchToggleButtonStyle}" IsChecked="{Binding IsPcbControllerSelected}" Command="{Binding SelectPcbControllerCommand}" Margin="8" Width="140" Height="75" Background="#4A6B4A">
                    <TextBlock Text="PCB-Controller" Foreground="White" FontWeight="Bold" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </ToggleButton>

                <!-- RCB-Controller -->
                <ToggleButton Grid.Row="1" Grid.Column="2" Style="{StaticResource FlatTouchToggleButtonStyle}" IsChecked="{Binding IsRcbControllerSelected}" Command="{Binding SelectRcbControllerCommand}" Margin="8" Width="140" Height="75" Background="#4A6B4A">
                    <TextBlock Text="RCB-Controller" Foreground="White" FontWeight="Bold" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </ToggleButton>
            </Grid>
        </Grid>

        <!-- ── RIGHT PANEL: SIREN STATUS LIST SIDEBAR (No Gap, Starts from top) ── -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Background="#333333" BorderBrush="White" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="#262626" BorderBrush="White" BorderThickness="0,0,0,1">
                    <TextBlock Text="STATUS" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- List of sirens -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding AllSirenItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#444444" BorderThickness="0,0,0,1" Padding="8,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Status dot -->
                                        <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5"
                                                Background="{Binding StatusColor}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        
                                        <!-- Name & Address inline -->
                                        <TextBlock Grid.Column="1" Foreground="White" FontSize="11" Margin="6,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center">
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text=" with device address " Foreground="#AAAAAA"/>
                                            <Run Text="{Binding AddressDisplay, Mode=OneWay}" Foreground="#AAAAAA"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ── ROW 2: Live Logs Terminal spanning across full width ────── -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="#F8FAFC" BorderBrush="White" BorderThickness="0,1,0,0" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Terminal Header -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Console" Width="14" Height="14" 
                                                 Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Live Communication Terminal Logs" Foreground="#10B981" 
                                   FontWeight="Bold" FontSize="11" VerticalAlignment="Center" FontFamily="Consolas"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="COM6 @ 1200 bps" Foreground="{StaticResource TextSecondary}" 
                                   FontSize="10" VerticalAlignment="Center" FontFamily="Consolas" Margin="0,0,10,0"/>
                        <Button x:Name="CopyLogsButton" Command="{Binding CopyLogsCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Padding="6,2" Height="20"
                                Foreground="#10B981" BorderBrush="#10B981" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentCopy" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Copy" FontSize="9" FontFamily="Consolas" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Logs list -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding CommLogs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{Binding Converter={StaticResource LogColorConverter}}" FontSize="11" 
                                           FontFamily="Consolas" TextWrapping="Wrap" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ── ACTIVATION SEQUENCE POPUP OVERLAY (Z-Index Floating Window) ── -->
        <Grid Visibility="{Binding IsConfirmingCommand, Converter={StaticResource BooleanToVisibilityConverter}}"
              Grid.RowSpan="3" Grid.ColumnSpan="2" Panel.ZIndex="9999" Background="#33000000">
            <Border Width="380" Height="485" Background="#5A5A5A" BorderBrush="White" BorderThickness="1" CornerRadius="4"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="25" ShadowDepth="4" Opacity="0.5"/>
                </Border.Effect>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Title Bar -->
                    <Border Grid.Row="0" Background="White" CornerRadius="3,3,0,0">
                        <Grid>
                            <TextBlock Text="Activation Sequence" Foreground="Black" FontWeight="SemiBold" FontSize="13" 
                                       VerticalAlignment="Center" Margin="10,0"/>
                            <Button HorizontalAlignment="Right" Width="32" Height="32" Background="#D32F2F" BorderThickness="0"
                                    Command="{Binding CancelActivateCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="0">
                                <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Popup Body -->
                    <Grid Grid.Row="1" Margin="20,15,20,15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Large Subtitle -->
                        <TextBlock Grid.Row="0" Text="{Binding CommandToConfirmName}" Foreground="White" FontSize="20" 
                                   FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                        <!-- Confirm Activation Button -->
                        <Button Grid.Row="1" Command="{Binding ExecuteActivateCommand}" Width="180" Height="90"
                                Background="#E0E0E0" BorderThickness="0" Foreground="Black" materialDesign:ButtonAssist.CornerRadius="4"
                                FontWeight="Bold" FontSize="15" Style="{StaticResource MaterialDesignFlatButton}">
                            <TextBlock Text="Confirm Activation" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Abort Activation Button -->
                        <Button Grid.Row="2" Command="{Binding CancelActivateCommand}" Width="180" Height="28" Margin="0,10,0,0"
                                Background="#E0E0E0" BorderThickness="0" Foreground="Black" materialDesign:ButtonAssist.CornerRadius="4"
                                FontSize="11" Style="{StaticResource MaterialDesignFlatButton}">
                            <TextBlock Text="Abort Activation" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Activation Information Group Box -->
                        <Border Grid.Row="3" BorderBrush="White" BorderThickness="1" CornerRadius="4" Margin="0,15,0,10" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Row 0: Activation Sequence -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Activation Sequence" Foreground="White" FontSize="11" VerticalAlignment="Center" Margin="0,4,8,4"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CommandToConfirmName, Mode=OneWay}" IsReadOnly="True" 
                                         Background="White" Foreground="Black" BorderThickness="0" Height="20" Padding="4,0" FontSize="11" VerticalContentAlignment="Center" Margin="0,4"/>

                                <!-- Row 1: Activation Sequence Description -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Activation Sequence Description" Foreground="White" FontSize="11" Margin="0,6,8,0" TextWrapping="Wrap"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="Triggers emergency alert broadcast sequence." IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                         Background="White" Foreground="Black" BorderThickness="0" Padding="4" FontSize="11" Margin="0,4"/>

                                <!-- Row 2: Process -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Process" Foreground="White" FontSize="11" VerticalAlignment="Center" Margin="0,4,8,4"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="Task 0/3 - No Command" IsReadOnly="True" 
                                         Background="White" Foreground="Black" BorderThickness="0" Height="20" Padding="4,0" FontSize="11" VerticalContentAlignment="Center" Margin="0,4"/>
                            </Grid>
                        </Border>

                        <!-- Hide Window Button -->
                        <Button Grid.Row="4" Command="{Binding CancelActivateCommand}" HorizontalAlignment="Right" Width="90" Height="28"
                                Background="#2A75B3" BorderThickness="0" Foreground="White" materialDesign:ButtonAssist.CornerRadius="3"
                                FontSize="11" FontWeight="SemiBold" Style="{StaticResource MaterialDesignFlatButton}">
                            <TextBlock Text="Hide Window" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ── ACTIVE RUNNING COMMAND OVERLAY ────────────────────────────── -->
        <Grid Visibility="{Binding IsCommandRunning, Converter={StaticResource BooleanToVisibilityConverter}}"
              Grid.RowSpan="3" Grid.ColumnSpan="2" Panel.ZIndex="9999" Background="#99000000">
            <Border Background="{StaticResource CardBackground}" CornerRadius="12" Padding="30"
                    Width="340" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#10B981" BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect Color="#10B981" BlurRadius="40" ShadowDepth="0" Opacity="0.4"/>
                </Border.Effect>
                
                <StackPanel>
                    <!-- Active Icon -->
                    <Grid HorizontalAlignment="Center" Margin="0,0,0,16" Width="100" Height="100">
                        
                        <!-- Glowing PA background mapped to volume -->
                        <Ellipse Fill="#3B82F6" Opacity="{Binding MicrophoneVolume}" 
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Width="100" Height="100"
                                 Visibility="{Binding IsPublicAddressActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        
                        <!-- PA Microphone Icon -->
                        <Border Width="72" Height="72" CornerRadius="36" Background="#1A3B82F6"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsPublicAddressActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <materialDesign:PackIcon Kind="Microphone" Width="36" Height="36"
                                                     Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
 
                        <!-- Standard Radio Tower Icon -->
                        <Border Width="72" Height="72" CornerRadius="36" Background="#1A10B981"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPublicAddressActive}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <materialDesign:PackIcon Kind="RadioTower" Width="36" Height="36"
                                                     Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    
                    <!-- Title -->
                    <TextBlock Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold" 
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,12">
                        <Run Text="Command '"/>
                        <Run Text="{Binding CommandToConfirmName}"/>
                        <Run Text="' is ACTIVE!"/>
                    </TextBlock>
                    
                    <!-- Subtitle / Countdown -->
                    <TextBlock Text="{Binding ActiveDurationDisplay}" Foreground="#10B981" 
                               FontSize="14" FontWeight="Bold" TextAlignment="Center" 
                               Margin="0,0,0,24" />
                    
                    <!-- Stop Button -->
                    <Button Command="{Binding StopRunningCommandCommand}"
                            Background="#EF4444" Foreground="White" BorderThickness="0"
                            Height="40" materialDesign:ButtonAssist.CornerRadius="5">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="StopCircleOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Stop Command (Cancel)" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
