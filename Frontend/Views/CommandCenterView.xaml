<UserControl x:Class="Keemya.Frontend.Views.CommandCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:Keemya.Frontend.ViewModels"
             xmlns:views="clr-namespace:Keemya.Frontend.Views"
             mc:Ignorable="d" d:DesignHeight="768" d:DesignWidth="1366">

    <UserControl.Resources>
        <!-- Log Color Converter -->
        <views:LogColorConverter x:Key="LogColorConverter"/>

        <!-- Converter for bool → Visibility -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Custom Row Button Template to avoid default WPF styling/squashing -->
        <Style x:Key="ClickableRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat square button style with white border and NO drop shadow -->
        <Style x:Key="FlatTouchButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat square toggle button style with white border, NO drop shadow, and yellow highlight border when selected -->
        <Style x:Key="FlatTouchToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFFF00"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#5A5A5A">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>      <!-- Column 0: Left panel content -->
            <ColumnDefinition Width="260"/>    <!-- Column 1: STATUS sidebar -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Back Button -->
            <RowDefinition Height="*"/>    <!-- Row 1: Main Touch Console Buttons Grid -->
            <RowDefinition Height="160"/>  <!-- Row 2: Live Logs Terminal -->
        </Grid.RowDefinitions>

        <!-- ── ROW 0: Back to Modules Button ────────────────────────────── -->
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="10,10,10,5">
            <Button Command="{Binding BackCommand}" HorizontalAlignment="Left"
                    Background="#333333" BorderBrush="White" BorderThickness="1"
                    Foreground="White" Padding="15,6" Height="36"
                    Style="{StaticResource MaterialDesignFlatButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16"
                                            Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Back to Modules" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- ── ROW 1: Main Touch Console Buttons Grid (LEFT PANEL) ──────── -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Column 0: Left console buttons -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Alarm Grid (Top) -->
                <Grid Grid.Row="0" Margin="20,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 0 -->
                    <!-- FIRE ALARM -->
                    <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource FlatTouchButtonStyle}" Command="{Binding SelectFireAlarmCommand}" Margin="8" Width="140" Height="75" Background="#A72A2A">
                        <TextBlock Text="FIRE ALARM" Foreground="White" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <!-- GAS ALARM -->
                    <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource FlatTouchButtonStyle}" Command="{Binding SelectGasAlarmCommand}" Margin="8" Width="140" Height="75" Background="#E68A00">
                        <TextBlock Text="GAS ALARM" Foreground="White" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <!-- ALL CLEAR ALARM -->
                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource FlatTouchButtonStyle}" Command="{Binding SelectAllClearAlarmCommand}" Margin="8" Width="140" Height="75" Background="#2A75B3">
                        <TextBlock Text="ALL CLEAR ALARM" Foreground="White" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <!-- Row 1 -->
                    <!-- RESET ALARM -->
                    <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource FlatTouchButtonStyle}" Command="{Binding SelectResetAlarmCommand}" Margin="8" Width="140" Height="75" Background="#E6D900">
                        <TextBlock Text="RESET ALARM" Foreground="Black" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <!-- PUBLIC ADDRESS -->
                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource FlatTouchButtonStyle}" Command="{Binding SelectPublicAddressCommand}" Margin="8" Width="140" Height="75" Background="#3B82F6">
                        <TextBlock Text="PUBLIC ADDRESS" Foreground="White" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <!-- ATTENTION -->
                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource FlatTouchButtonStyle}" Command="{Binding SelectAttentionCommand}" Margin="8" Width="140" Height="75" Background="#5C2AB3">
                        <TextBlock Text="ATTENTION" Foreground="White" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </Grid>

                <!-- Station Grid (Bottom) -->
                <Grid Grid.Row="2" Margin="20,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 0 -->
                    <!-- Admin ECC -->
                    <ToggleButton Grid.Row="0" Grid.Column="0" Style="{StaticResource FlatTouchToggleButtonStyle}" IsChecked="{Binding IsAdminEccSelected}" Command="{Binding SelectAdminEccCommand}" Margin="8" Width="140" Height="75" Background="{Binding AdminEccStatusColor}">
                        <TextBlock Text="{Binding AdminEccButtonText}" Foreground="White" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </ToggleButton>

                    <!-- PCB/ECS -->
                    <ToggleButton Grid.Row="0" Grid.Column="1" Style="{StaticResource FlatTouchToggleButtonStyle}" IsChecked="{Binding IsPcbEcsSelected}" Command="{Binding SelectPcbEcsCommand}" Margin="8" Width="140" Height="75" Background="{Binding PcbEcsStatusColor}">
                        <TextBlock Text="{Binding PcbEcsButtonText}" Foreground="White" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </ToggleButton>

                    <!-- RCB/ECS -->
                    <ToggleButton Grid.Row="0" Grid.Column="2" Style="{StaticResource FlatTouchToggleButtonStyle}" IsChecked="{Binding IsRcbEcsSelected}" Command="{Binding SelectRcbEcsCommand}" Margin="8" Width="140" Height="75" Background="{Binding RcbEcsStatusColor}">
                        <TextBlock Text="{Binding RcbEcsButtonText}" Foreground="White" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </ToggleButton>

                    <!-- Row 1 -->
                    <!-- PCB-Controller -->
                    <Border Grid.Row="1" Grid.Column="1" CornerRadius="2" BorderThickness="1" BorderBrush="#555555" Background="{Binding PcbControllerStatusColor}" Margin="8" Width="140" Height="75">
                        <TextBlock Text="PCB-Controller" Foreground="White" FontWeight="Bold" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- RCB-Controller -->
                    <Border Grid.Row="1" Grid.Column="2" CornerRadius="2" BorderThickness="1" BorderBrush="#555555" Background="{Binding RcbControllerStatusColor}" Margin="8" Width="140" Height="75">
                        <TextBlock Text="RCB-Controller" Foreground="White" FontWeight="Bold" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Grid>

            <!-- Column 1: Middle Voice Dispatch Wizard (Exactly matching user's layout screenshot) -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="30,10,30,10">
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Stretch">
                    <StackPanel.Resources>
                        <!-- Custom styled dark ComboBox -->
                        <Style TargetType="ComboBox" x:Key="DarkComboBoxStyle">
                            <Setter Property="Background" Value="#2D2D2D"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderBrush" Value="#555555"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Height" Value="36"/>
                            <Setter Property="Margin" Value="0,0,0,15"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBox">
                                        <Grid>
                                            <ToggleButton x:Name="ToggleButton" 
                                                          Style="{x:Null}"
                                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                                          Background="{TemplateBinding Background}" 
                                                          Foreground="{TemplateBinding Foreground}"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Stretch"
                                                          Focusable="false"
                                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                                          ClickMode="Press">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="Border" 
                                                                Background="{TemplateBinding Background}" 
                                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                                BorderThickness="1" 
                                                                CornerRadius="4">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition />
                                                                    <ColumnDefinition Width="30" />
                                                                </Grid.ColumnDefinitions>
                                                                <!-- Down Arrow -->
                                                                <Path x:Name="Arrow" 
                                                                      Grid.Column="1" 
                                                                      Fill="White" 
                                                                      HorizontalAlignment="Center" 
                                                                      VerticalAlignment="Center" 
                                                                      Data="M 0 0 L 4 4 L 8 0 Z"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="true">
                                                                <Setter TargetName="Border" Property="Background" Value="#3D3D3D" />
                                                            </Trigger>
                                                            <Trigger Property="IsChecked" Value="true">
                                                                <Setter TargetName="Border" Property="Background" Value="#1E1E1E" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                            
                                            <!-- Selected Item Presenter -->
                                            <ContentPresenter x:Name="ContentSite" 
                                                              IsHitTestVisible="False" 
                                                              Content="{TemplateBinding SelectionBoxItem}" 
                                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                                              Margin="10,3,30,3" 
                                                              VerticalAlignment="Center" 
                                                              HorizontalAlignment="Left">
                                                <!-- Force the selected text inside the closed combo to be bold white -->
                                                <ContentPresenter.Resources>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </Style>
                                                </ContentPresenter.Resources>
                                            </ContentPresenter>

                                            <!-- Dropdown Popup -->
                                            <Popup x:Name="Popup" 
                                                   Placement="Bottom" 
                                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                                   AllowsTransparency="True" 
                                                   Focusable="False" 
                                                   PopupAnimation="Slide">
                                                <Grid x:Name="DropDown" 
                                                      SnapsToDevicePixels="True" 
                                                      MinWidth="{TemplateBinding ActualWidth}" 
                                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                    <Border x:Name="DropDownBorder" 
                                                            Background="#2D2D2D" 
                                                            BorderBrush="#555555" 
                                                            BorderThickness="1" 
                                                            CornerRadius="4"
                                                            Margin="0,2,0,0">
                                                        <ScrollViewer SnapsToDevicePixels="True">
                                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                                        </ScrollViewer>
                                                    </Border>
                                                </Grid>
                                            </Popup>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <!-- ComboBoxItem Style override -->
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Background" Value="#2D2D2D"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="FontSize" Value="12.5"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3D3D3D"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#4D4D4D"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Resources>
                    <!-- Title -->
                    <TextBlock Text="Weekly test" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <!-- Audio Player Control -->
                    <Border Background="#2D2D2D" BorderBrush="#444444" BorderThickness="1" CornerRadius="6" Padding="10,10" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Play/Pause Button -->
                                <ColumnDefinition Width="*"/>    <!-- Track Slider -->
                                <ColumnDefinition Width="Auto"/> <!-- Timer Display -->
                                <ColumnDefinition Width="Auto"/> <!-- Message Button -->
                            </Grid.ColumnDefinitions>

                            <!-- Play/Pause Toggle -->
                            <Button Grid.Column="0" Command="{Binding TogglePlayCommand}" Width="32" Height="32" Background="Transparent" BorderBrush="Transparent" Padding="0" Cursor="Hand" Margin="0,0,8,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent">
                                            <Path Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Width="14" Height="14">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAudioPlaying}" Value="True">
                                                                <Setter Property="Data" Value="M 6 4 L 10 4 L 10 20 L 6 20 Z M 14 4 L 18 4 L 18 20 L 14 20 Z"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsAudioPlaying}" Value="False">
                                                                <Setter Property="Data" Value="M 6 4 L 20 12 L 6 20 Z"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Track Seek Slider -->
                            <Slider Grid.Column="1" Minimum="0" Maximum="{Binding AudioDuration}" Value="{Binding AudioPosition}" VerticalAlignment="Center" Foreground="#3B82F6" Cursor="Hand" Margin="4,0,8,0" IsEnabled="{Binding IsAudioPlaying}"/>

                            <!-- Timer Display -->
                            <TextBlock Grid.Column="2" Text="{Binding AudioPositionText}" Foreground="White" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <!-- Message Button -->
                            <Button Grid.Column="3" Content="Message" Background="#3A3A3A" Foreground="White" BorderBrush="White" BorderThickness="1" Padding="8,4" Height="28" FontSize="11" Style="{StaticResource FlatTouchButtonStyle}"/>
                        </Grid>
                    </Border>

                    <!-- Sub-heading -->
                    <TextBlock Text="ANCESSURNT" Foreground="#AAAAAA" FontSize="11" FontWeight="Bold" Margin="0,5,0,8"/>

                    <!-- 6 Dropdowns in 2 Rows of 3 Grid -->
                    <Grid Margin="0,0,0,15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/> <!-- Spacer Row -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/> <!-- Spacer Column -->
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/> <!-- Spacer Column -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Row 0, Column 0: Event -->
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Event" Foreground="White" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource DarkComboBoxStyle}" ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}"/>
                        </StackPanel>

                        <!-- Row 0, Column 2: Type -->
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Type" Foreground="White" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource DarkComboBoxStyle}" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}"/>
                        </StackPanel>

                        <!-- Row 0, Column 4: Category -->
                        <StackPanel Grid.Row="0" Grid.Column="4">
                            <TextBlock Text="Category" Foreground="White" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource DarkComboBoxStyle}" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"/>
                        </StackPanel>

                        <!-- Row 2, Column 0: Plant -->
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Plant" Foreground="White" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource DarkComboBoxStyle}" ItemsSource="{Binding Areas}" SelectedItem="{Binding SelectedArea}"/>
                        </StackPanel>

                        <!-- Row 2, Column 2: Wind direction -->
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Wind direction" Foreground="White" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource DarkComboBoxStyle}" ItemsSource="{Binding WindDirections}" SelectedItem="{Binding SelectedWindDirection}"/>
                        </StackPanel>

                        <!-- Row 2, Column 4: Assembly point -->
                        <StackPanel Grid.Row="2" Grid.Column="4">
                            <TextBlock Text="Assembly point" Foreground="White" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource DarkComboBoxStyle}" ItemsSource="{Binding AssemblyPoints}" SelectedItem="{Binding SelectedAssemblyPoint}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Action Check Button -->
                    <Button Content="Check option" Command="{Binding CheckOptionCommand}" Background="#801D38" Foreground="White" BorderThickness="0" Height="40" Margin="0,5,0,15" FontSize="13" FontWeight="Bold" Style="{StaticResource FlatTouchButtonStyle}"/>

                    <!-- Preview Selection Summary -->
                    <TextBlock Text="{Binding SelectedSummaryText}" Foreground="#D1D5DB" FontSize="12.5" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ── RIGHT PANEL: SIREN STATUS LIST SIDEBAR (No Gap, Starts from top) ── -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Background="#333333" BorderBrush="White" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="#262626" BorderBrush="White" BorderThickness="0,0,0,1">
                    <TextBlock Text="STATUS" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- List of sirens -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AllSirenItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#444444" BorderThickness="0,0,0,1" Padding="8,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Status dot -->
                                            <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5"
                                                    Background="{Binding StatusColor}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                            
                                            <!-- Name & Address inline -->
                                            <TextBlock Grid.Column="1" Foreground="White" FontSize="11" Margin="6,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center">
                                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text=" with device address " Foreground="#AAAAAA"/>
                                                <Run Text="{Binding AddressDisplay, Mode=OneWay}" Foreground="#AAAAAA"/>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Workstation & Controller Status Grid -->
                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <Border Background="#262626" BorderBrush="#444444" BorderThickness="0,1,0,1" Padding="0,8">
                            <TextBlock Text="SYSTEM GATEWAYS" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                        </Border>
                        <ItemsControl ItemsSource="{Binding StationStatuses}" Margin="5,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusColorBrush}" BorderBrush="White" BorderThickness="1" CornerRadius="3" Margin="3" Height="34" SnapsToDevicePixels="True">
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ── ROW 2: Live Logs Terminal spanning across full width ────── -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="#F8FAFC" BorderBrush="White" BorderThickness="0,1,0,0" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Terminal Header -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Console" Width="14" Height="14" 
                                                 Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Live Communication Terminal Logs" Foreground="#10B981" 
                                   FontWeight="Bold" FontSize="11" VerticalAlignment="Center" FontFamily="Consolas"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="COM6 @ 1200 bps" Foreground="{StaticResource TextSecondary}" 
                                   FontSize="10" VerticalAlignment="Center" FontFamily="Consolas" Margin="0,0,10,0"/>
                        <Button x:Name="CopyLogsButton" Command="{Binding CopyLogsCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Padding="6,2" Height="20"
                                Foreground="#10B981" BorderBrush="#10B981" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentCopy" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Copy" FontSize="9" FontFamily="Consolas" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Logs list -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding CommLogs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{Binding Converter={StaticResource LogColorConverter}}" FontSize="11" 
                                           FontFamily="Consolas" TextWrapping="Wrap" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ── ACTIVATION SEQUENCE POPUP OVERLAY (Z-Index Floating Window) ── -->
        <Grid Visibility="{Binding IsConfirmingCommand, Converter={StaticResource BooleanToVisibilityConverter}}"
              Grid.RowSpan="3" Grid.ColumnSpan="2" Panel.ZIndex="9999" Background="#33000000">
            <Border Width="380" Height="485" Background="#5A5A5A" BorderBrush="White" BorderThickness="1" CornerRadius="4"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="25" ShadowDepth="4" Opacity="0.5"/>
                </Border.Effect>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Title Bar -->
                    <Border Grid.Row="0" Background="White" CornerRadius="3,3,0,0">
                        <Grid>
                            <TextBlock Text="{Binding TitleBarText}" Foreground="Black" FontWeight="SemiBold" FontSize="13" 
                                       VerticalAlignment="Center" Margin="10,0"/>
                            <Button HorizontalAlignment="Right" Width="32" Height="32" Background="#D32F2F" BorderThickness="0"
                                    Command="{Binding CancelActivateCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="0">
                                <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Popup Body -->
                    <Grid Grid.Row="1" Margin="20,15,20,15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Large Subtitle -->
                        <TextBlock Grid.Row="0" Text="{Binding CommandToConfirmName}" Foreground="White" FontSize="20" 
                                   FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                        <!-- Confirm Activation Button -->
                        <Button Grid.Row="1" Command="{Binding ExecuteActivateCommand}" Width="180" Height="90"
                                Background="#E0E0E0" BorderThickness="0" Foreground="Black" materialDesign:ButtonAssist.CornerRadius="4"
                                FontWeight="Bold" FontSize="15" Style="{StaticResource MaterialDesignFlatButton}">
                            <TextBlock Text="{Binding ConfirmButtonText}" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Abort Activation Button -->
                        <Button Grid.Row="2" Command="{Binding CancelActivateCommand}" Width="180" Height="28" Margin="0,10,0,0"
                                Background="#E0E0E0" BorderThickness="0" Foreground="Black" materialDesign:ButtonAssist.CornerRadius="4"
                                FontSize="11" Style="{StaticResource MaterialDesignFlatButton}">
                            <TextBlock Text="{Binding AbortButtonText}" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Activation Information Group Box -->
                        <Border Grid.Row="3" BorderBrush="White" BorderThickness="1" CornerRadius="4" Margin="0,15,0,10" Padding="10"
                                Visibility="{Binding SirenDetailsVisibility}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Row 0: Activation Sequence -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Activation Sequence" Foreground="White" FontSize="11" VerticalAlignment="Center" Margin="0,4,8,4"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CommandToConfirmName, Mode=OneWay}" IsReadOnly="True" 
                                         Background="White" Foreground="Black" BorderThickness="0" Height="20" Padding="4,0" FontSize="11" VerticalContentAlignment="Center" Margin="0,4"/>

                                <!-- Row 1: Activation Sequence Description -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Activation Sequence Description" Foreground="White" FontSize="11" Margin="0,6,8,0" TextWrapping="Wrap"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="Triggers emergency alert broadcast sequence." IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                         Background="White" Foreground="Black" BorderThickness="0" Padding="4" FontSize="11" Margin="0,4"/>

                                <!-- Row 2: Process -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Process" Foreground="White" FontSize="11" VerticalAlignment="Center" Margin="0,4,8,4"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="Task 0/3 - No Command" IsReadOnly="True" 
                                         Background="White" Foreground="Black" BorderThickness="0" Height="20" Padding="4,0" FontSize="11" VerticalContentAlignment="Center" Margin="0,4"/>
                            </Grid>
                        </Border>

                        <!-- Hide Window Button -->
                        <Button Grid.Row="4" Command="{Binding CancelActivateCommand}" HorizontalAlignment="Right" Width="90" Height="28"
                                Background="#2A75B3" BorderThickness="0" Foreground="White" materialDesign:ButtonAssist.CornerRadius="3"
                                FontSize="11" FontWeight="SemiBold" Style="{StaticResource MaterialDesignFlatButton}">
                            <TextBlock Text="Hide Window" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ── ACTIVE RUNNING COMMAND OVERLAY ────────────────────────────── -->
        <Grid Visibility="{Binding IsCommandRunning, Converter={StaticResource BooleanToVisibilityConverter}}"
              Grid.RowSpan="3" Grid.ColumnSpan="2" Panel.ZIndex="9999" Background="#99000000">
            <Border Background="{StaticResource CardBackground}" CornerRadius="12" Padding="30"
                    Width="340" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#10B981" BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect Color="#10B981" BlurRadius="40" ShadowDepth="0" Opacity="0.4"/>
                </Border.Effect>
                
                <StackPanel>
                    <!-- Active Icon -->
                    <Grid HorizontalAlignment="Center" Margin="0,0,0,16" Width="100" Height="100">
                        
                        <!-- Glowing PA background mapped to volume -->
                        <Ellipse Fill="#3B82F6" Opacity="{Binding MicrophoneVolume}" 
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Width="100" Height="100"
                                 Visibility="{Binding IsPublicAddressActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        
                        <!-- PA Microphone Icon -->
                        <Border Width="72" Height="72" CornerRadius="36" Background="#1A3B82F6"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsPublicAddressActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <materialDesign:PackIcon Kind="Microphone" Width="36" Height="36"
                                                     Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
 
                        <!-- Standard Radio Tower Icon -->
                        <Border Width="72" Height="72" CornerRadius="36" Background="#1A10B981"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPublicAddressActive}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <materialDesign:PackIcon Kind="RadioTower" Width="36" Height="36"
                                                     Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    
                    <!-- Title -->
                    <TextBlock Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold" 
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,12">
                        <Run Text="Command '"/>
                        <Run Text="{Binding CommandToConfirmName}"/>
                        <Run Text="' is ACTIVE!"/>
                    </TextBlock>
                    
                    <!-- Subtitle / Countdown -->
                    <TextBlock Text="{Binding ActiveDurationDisplay}" Foreground="#10B981" 
                               FontSize="14" FontWeight="Bold" TextAlignment="Center" 
                               Margin="0,0,0,24" />
                    
                    <!-- Stop Button -->
                    <Button Command="{Binding StopRunningCommandCommand}"
                            Background="#EF4444" Foreground="White" BorderThickness="0"
                            Height="40" materialDesign:ButtonAssist.CornerRadius="5">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="StopCircleOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Stop Command (Cancel)" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
