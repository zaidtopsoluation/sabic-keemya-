<UserControl x:Class="Keemya.Frontend.Views.ServiceManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Keemya.Frontend.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1366">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Row 0: Back Button -->
            <RowDefinition Height="Auto" /> <!-- Row 1: Header Title & Actions -->
            <RowDefinition Height="*" />    <!-- Row 2: Multi-Siren Card Grid -->
        </Grid.RowDefinitions>

        <!-- Row 0: Back Button -->
        <StackPanel Grid.Row="0" Margin="25,15,25,10">
            <Button Command="{Binding BackCommand}" HorizontalAlignment="Left" Background="White" BorderBrush="#E2E8F0" Foreground="#1E293B" Padding="15,8" Style="{StaticResource MaterialDesignFlatButton}" materialDesign:ButtonAssist.CornerRadius="6">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource BackToModules}" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Row 1: Title and Header Action Buttons -->
        <Grid Grid.Row="1" Margin="25,0,25,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Service Management" FontSize="26" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4" />
                <TextBlock Text="Operational diagnostics, maintenance cycles, and system service controls" FontSize="13" Foreground="#64748B" />
            </StackPanel>

            <!-- Top Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding SiTestAllSelectedCommand}" Background="#1D4ED8" BorderBrush="Transparent" Foreground="White" Padding="18,0" Height="40" Margin="0,0,10,0" materialDesign:ButtonAssist.CornerRadius="8" FontWeight="Bold" FontSize="13">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PlayCircleOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="SI Test All Sirens" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Row 2: Multi-Siren Cards Grid -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="25,0,25,25">
            <ItemsControl ItemsSource="{Binding Sirens}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,0,20,20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.04" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- Header: Icon, Name, Address, Status dot -->
                                    <RowDefinition Height="Auto" /> <!-- Metrics: Battery DC, AC Charger, Temp -->
                                    <RowDefinition Height="Auto" /> <!-- Divider -->
                                    <RowDefinition Height="Auto" /> <!-- Diagnostic Status Indicators (2 Columns) -->
                                    <RowDefinition Height="Auto" /> <!-- Action Button: Activate / Offline -->
                                </Grid.RowDefinitions>

                                <!-- Row 0: Card Header -->
                                <Grid Grid.Row="0" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon Circle -->
                                    <Border Grid.Column="0" Width="38" Height="38" Background="#EFF6FF" CornerRadius="19" Margin="0,0,12,0">
                                        <materialDesign:PackIcon Kind="VolumeHigh" Width="20" Height="20" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Name & Address Subtext -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" Foreground="#0F172A"/>
                                        <TextBlock Text="{Binding Subtext}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Status Dot -->
                                    <Border Grid.Column="2" Width="12" Height="12" CornerRadius="6" Background="{Binding StatusColorBrush}" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Row 1: Metrics Row -->
                                <Grid Grid.Row="1" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Battery DC -->
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="BatteryCharging" Width="20" Height="20" Foreground="#D97706" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding BatteryVoltage, StringFormat='{}{0:F1}V'}" FontWeight="Bold" FontSize="15" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Battery (DC)" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- AC Charger -->
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Flash" Width="20" Height="20" Foreground="#059669" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding AcVolts, StringFormat='{}{0:F0}V'}" FontWeight="Bold" FontSize="15" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                        <TextBlock Text="AC Charger" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Temp -->
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Thermometer" Width="20" Height="20" Foreground="#DC2626" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding CabTemp, StringFormat='{}{0:F1}°C'}" FontWeight="Bold" FontSize="15" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Temp" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 2: Divider Line -->
                                <Border Grid.Row="2" Height="1" Background="#F1F5F9" Margin="0,0,0,16"/>

                                <!-- Row 3: Diagnostic Status Indicators (2 Columns of 5 items) -->
                                <Grid Grid.Row="3" Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Column -->
                                    <StackPanel Grid.Column="0">
                                        <!-- AC Charger Power -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Grid.Column="0" Kind="Flash" Width="14" Height="14" Foreground="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="AC Charger Power" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#EF4444"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AcPowerOn}" Value="True">
                                                                <Setter Property="Background" Value="#10B981"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>

                                        <!-- Strobevisor Module -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Grid.Column="0" Kind="Lightbulb" Width="14" Height="14" Foreground="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Strobevisor Module" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#10B981"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StrobeActive}" Value="True">
                                                                <Setter Property="Background" Value="#EF4444"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>

                                        <!-- System Armed -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Grid.Column="0" Kind="ShieldLock" Width="14" Height="14" Foreground="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="System Armed" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#94A3B8"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SystemArmed}" Value="True">
                                                                <Setter Property="Background" Value="#10B981"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>

                                        <!-- Tone Generator Bias -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Grid.Column="0" Kind="SineWave" Width="14" Height="14" Foreground="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Tone Generator Bias" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#EF4444"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding BiasDetected}" Value="True">
                                                                <Setter Property="Background" Value="#10B981"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>

                                        <!-- Partial Alert Diagnostics -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Grid.Column="0" Kind="CheckboxMarkedCircleOutline" Width="14" Height="14" Foreground="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Partial Alert Diagnostics" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#EF4444"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PartialAlert}" Value="True">
                                                                <Setter Property="Background" Value="#10B981"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Right Column -->
                                    <StackPanel Grid.Column="2">
                                        <!-- Cabinet Door -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Grid.Column="0" Kind="Door" Width="14" Height="14" Foreground="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Cabinet Door" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#10B981"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DoorIntruded}" Value="True">
                                                                <Setter Property="Background" Value="#EF4444"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>

                                        <!-- Supervisor Board -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Grid.Column="0" Kind="Security" Width="14" Height="14" Foreground="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Supervisor Board" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#10B981"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SupervisorMode}" Value="True">
                                                                <Setter Property="Background" Value="#EF4444"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>

                                        <!-- Rotator Mechanical State -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Grid.Column="0" Kind="Cached" Width="14" Height="14" Foreground="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Rotator Mechanical State" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#94A3B8"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RotorActive}" Value="True">
                                                                <Setter Property="Background" Value="#10B981"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>

                                        <!-- Full Alert Diagnostics -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Grid.Column="0" Kind="CheckboxMarkedCircle" Width="14" Height="14" Foreground="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Full Alert Diagnostics" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#EF4444"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FullAlert}" Value="True">
                                                                <Setter Property="Background" Value="#10B981"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 4: Bottom Action Button -->
                                <Button Grid.Row="4" Command="{Binding DataContext.SiTestSingleSirenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Height="42" FontWeight="Bold" FontSize="14" materialDesign:ButtonAssist.CornerRadius="8">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                            <Setter Property="Background" Value="#1D4ED8"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Content" Value="Activate"/>
                                            <Setter Property="IsEnabled" Value="True"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOffline}" Value="True">
                                                    <Setter Property="Background" Value="#EFF6FF"/>
                                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                                    <Setter Property="Content" Value="Offline"/>
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
