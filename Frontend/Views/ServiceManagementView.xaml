<UserControl x:Class="Keemya.Frontend.Views.ServiceManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Keemya.Frontend.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="768" d:DesignWidth="1366">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <!-- Custom ListBoxItem Style for a Premium sidebar list item -->
        <Style x:Key="SirenListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border" 
                                Background="{StaticResource AppBackground}" 
                                BorderBrush="{StaticResource CardBorder}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="14,12"
                                SnapsToDevicePixels="true">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="Border" Property="Background" Value="#EEF2FF"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#6366F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Command Card Styles -->
        <Style x:Key="CommandCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Row 0: Back Button -->
            <RowDefinition Height="Auto" /> <!-- Row 1: Header Title -->
            <RowDefinition Height="*" />    <!-- Row 2: Split Content Grid -->
        </Grid.RowDefinitions>

        <!-- Row 0: Back Button -->
        <StackPanel Grid.Row="0" Margin="20,15,20,10">
            <Button Command="{Binding BackCommand}" HorizontalAlignment="Left" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" Foreground="{StaticResource TextPrimary}" Padding="15,8" Style="{StaticResource MaterialDesignFlatButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource BackToModules}" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Row 1: Title and Subtitle -->
        <Grid Grid.Row="1" Margin="20,0,20,20">
            <StackPanel>
                <TextBlock Text="{DynamicResource ModServiceMgmt}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,5" />
                <TextBlock Text="{DynamicResource ModServiceMgmtDesc}" FontSize="14" Foreground="{StaticResource TextSecondary}" />
            </StackPanel>
        </Grid>

        <!-- Row 2: Split Content Grid -->
        <Grid Grid.Row="2" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" /> <!-- Left Sidebar: Siren Selection -->
                <ColumnDefinition Width="15" />  <!-- Spacing -->
                <ColumnDefinition Width="*" />    <!-- Right Side: Details and Commands -->
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR: Siren Selection -->
            <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Search Box -->
                        <RowDefinition Height="*" />    <!-- Siren ListBox -->
                        <RowDefinition Height="Auto" /> <!-- Count summary footer -->
                    </Grid.RowDefinitions>

                    <!-- Search Box -->
                    <Border Grid.Row="0" Height="40" Background="{StaticResource AppBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,0" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Search" Width="18" Height="18" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" CaretBrush="{StaticResource TextPrimary}" VerticalAlignment="Center" VerticalContentAlignment="Center" materialDesign:HintAssist.Hint="Search sirens..." materialDesign:HintAssist.Foreground="{StaticResource TextSecondary}"/>
                        </Grid>
                    </Border>

                    <!-- Siren ListBox -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ListBox ItemsSource="{Binding FilteredSirens}" 
                                 SelectedItem="{Binding SelectedSiren}"
                                 ItemContainerStyle="{StaticResource SirenListBoxItemStyle}"
                                 Background="Transparent" 
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Status Indicator dot -->
                                        <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5" Background="{Binding StatusColorBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                        <!-- Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding Subtext}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>

                        </ListBox>
                    </ScrollViewer>

                    <!-- Footer Count summary -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
                        <TextBlock TextAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondary}">
                            <Run Text="Showing "/>
                            <Run Text="{Binding FilteredSirens.Count, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            <Run Text=" of "/>
                            <Run Text="{Binding Sirens.Count, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            <Run Text=" sirens"/>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT SIDE: Details and Commands -->
            <Grid Grid.Column="2">
                <!-- If no siren selected display placeholder, else details -->
                <Grid Visibility="{Binding SelectedSiren, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Selected Siren Title -->
                        <RowDefinition Height="*" />    <!-- Status Indicators & Control Panels -->
                    </Grid.RowDefinitions>

                    <!-- Selected Siren Title Banner -->
                    <Border Grid.Row="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /> <!-- Icon -->
                                <ColumnDefinition Width="*" />    <!-- Name & Details -->
                                <ColumnDefinition Width="Auto" /> <!-- Status Badge -->
                            </Grid.ColumnDefinitions>
                            
                            <!-- Icon -->
                            <Border Grid.Column="0" Width="40" Height="40" Background="#EEF2FF" CornerRadius="6" Margin="0,0,15,0">
                                <materialDesign:PackIcon Kind="VolumeHigh" Width="22" Height="22" Foreground="#4F46E5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- Name & Details -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedSiren.Name}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,2"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="IP: " FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock Text="{Binding SelectedSiren.IpAddress}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,15,0" />
                                    <TextBlock Text="Area: " FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock Text="{Binding SelectedSiren.AreaCode}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,15,0" />
                                    <TextBlock Text="Address: " FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock Text="{Binding SelectedSiren.AddressCode}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Status Badge -->
                            <Border Grid.Column="2" CornerRadius="12" Padding="12,5" Background="{StaticResource AppBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="{Binding SelectedSiren.StatusColorBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedSiren.Status}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Row 1: Split Content Grid -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" /> <!-- Diagnostics & Sensors -->
                            <ColumnDefinition Width="15" />
                            <ColumnDefinition Width="1.2*" /> <!-- Routines & Activation Cards -->
                        </Grid.ColumnDefinitions>

                        <!-- Diagnostics & Sensors -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />    <!-- Status Indicators list -->
                                <RowDefinition Height="Auto" /> <!-- Sensors Cards -->
                            </Grid.RowDefinitions>

                            <!-- Status Indicators list -->
                            <Border Grid.Row="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                        <materialDesign:PackIcon Kind="HeartPulse" Width="18" Height="18" Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Diagnostics Status" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Indicators Grid -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <!-- AC Charger Power -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Kind="Flash" Width="16" Height="16" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,0" Grid.Column="0" VerticalAlignment="Center"/>
                                                <TextBlock Text="AC Charger Power" Foreground="{StaticResource TextPrimary}" FontSize="12" Grid.Column="1" VerticalAlignment="Center"/>
                                                <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,8,0" Grid.Column="2" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#EF4444" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HealthAcOn}" Value="True">
                                                                    <Setter Property="Background" Value="#10B981" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Grid>

                                            <!-- Cabinet Security -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Kind="Door" Width="16" Height="16" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,0" Grid.Column="0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Cabinet Door" Foreground="{StaticResource TextPrimary}" FontSize="12" Grid.Column="1" VerticalAlignment="Center"/>
                                                <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,8,0" Grid.Column="2" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#10B981" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HealthIntrusion}" Value="True">
                                                                    <Setter Property="Background" Value="#EF4444" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Grid>

                                            <!-- Strobe Lights -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Kind="Lightbulb" Width="16" Height="16" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,0" Grid.Column="0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Strobevisor Module" Foreground="{StaticResource TextPrimary}" FontSize="12" Grid.Column="1" VerticalAlignment="Center"/>
                                                <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,8,0" Grid.Column="2" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#10B981" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HealthStrobeActive}" Value="True">
                                                                    <Setter Property="Background" Value="#EF4444" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Grid>

                                            <!-- Supervisor Module -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Kind="Security" Width="16" Height="16" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,0" Grid.Column="0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Supervisor Board" Foreground="{StaticResource TextPrimary}" FontSize="12" Grid.Column="1" VerticalAlignment="Center"/>
                                                <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,8,0" Grid.Column="2" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#10B981" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HealthSupervisorMode}" Value="True">
                                                                    <Setter Property="Background" Value="#EF4444" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Grid>

                                            <!-- System State -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Kind="ShieldLock" Width="16" Height="16" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,0" Grid.Column="0" VerticalAlignment="Center"/>
                                                <TextBlock Text="System Armed" Foreground="{StaticResource TextPrimary}" FontSize="12" Grid.Column="1" VerticalAlignment="Center"/>
                                                <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,8,0" Grid.Column="2" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#6B7280" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HealthSystemArmed}" Value="True">
                                                                    <Setter Property="Background" Value="#10B981" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Grid>

                                            <!-- Mechanical Rotator -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Kind="Cached" Width="16" Height="16" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,0" Grid.Column="0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Rotator Mechanical State" Foreground="{StaticResource TextPrimary}" FontSize="12" Grid.Column="1" VerticalAlignment="Center"/>
                                                <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,8,0" Grid.Column="2" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#6B7280" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HealthRotorActive}" Value="True">
                                                                    <Setter Property="Background" Value="#10B981" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Grid>

                                            <!-- Tone Gen BIAS State -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Kind="SineWave" Width="16" Height="16" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,0" Grid.Column="0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Tone Generator Bias" Foreground="{StaticResource TextPrimary}" FontSize="12" Grid.Column="1" VerticalAlignment="Center"/>
                                                <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,8,0" Grid.Column="2" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#EF4444" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HealthBiasDetected}" Value="True">
                                                                    <Setter Property="Background" Value="#10B981" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Grid>

                                            <!-- Full Alert self test -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Kind="CheckboxMarkedCircle" Width="16" Height="16" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,0" Grid.Column="0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Full Alert Diagnostics" Foreground="{StaticResource TextPrimary}" FontSize="12" Grid.Column="1" VerticalAlignment="Center"/>
                                                <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,8,0" Grid.Column="2" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#EF4444" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HealthFullAlert}" Value="True">
                                                                    <Setter Property="Background" Value="#10B981" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Grid>

                                            <!-- Partial Alert self test -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Kind="CheckboxMarkedCircleOutline" Width="16" Height="16" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,0" Grid.Column="0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Partial Alert Diagnostics" Foreground="{StaticResource TextPrimary}" FontSize="12" Grid.Column="1" VerticalAlignment="Center"/>
                                                <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,8,0" Grid.Column="2" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#EF4444" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HealthPartialAlert}" Value="True">
                                                                    <Setter Property="Background" Value="#10B981" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Grid>

                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Sensors Cards Grid -->
                            <Grid Grid.Row="1" Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Battery DC -->
                                <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="BatteryCharging" Width="20" Height="20" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding HealthDcVoltage, StringFormat='{}{0:F1} V'}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Battery (DC)" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Charger AC -->
                                <Border Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Flash" Width="20" Height="20" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding HealthAcVoltage, StringFormat='{}{0:F1} V'}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                                        <TextBlock Text="AC Charger" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Cabinet Temp -->
                                <Border Grid.Column="4" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Thermometer" Width="20" Height="20" Foreground="#EF4444" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding HealthTemperature, StringFormat='{}{0:F1} °C'}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Temp" FontSize="10" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- Routines & Activation Cards -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /> <!-- Diagnostic Routines Buttons -->
                                <RowDefinition Height="*" />    <!-- Commands Scroll Cards List -->
                            </Grid.RowDefinitions>

                            <!-- Diagnostic Routines Buttons -->
                            <Border Grid.Row="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <materialDesign:PackIcon Kind="Wrench" Width="18" Height="18" Foreground="#4F46E5" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Diagnostics routines" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Command="{Binding ClickSirenCommand}" CommandParameter="{Binding SelectedSiren}" Background="{StaticResource AppBackground}" BorderBrush="{StaticResource CardBorder}" Foreground="{StaticResource TextPrimary}" Padding="0" Height="36" ToolTip="Query all telemetry endpoints sequentially" materialDesign:ButtonAssist.CornerRadius="6">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Sync Logs" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Background="{StaticResource AppBackground}" BorderBrush="{StaticResource CardBorder}" Foreground="{StaticResource TextPrimary}" Padding="0" Height="36" ToolTip="Calibrate rotating limit switches" materialDesign:ButtonAssist.CornerRadius="6">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Cached" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Calibrate" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="4" Background="{StaticResource AppBackground}" BorderBrush="{StaticResource CardBorder}" Foreground="{StaticResource TextPrimary}" Padding="0" Height="36" ToolTip="Test charging low thresholds" materialDesign:ButtonAssist.CornerRadius="6">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <materialDesign:PackIcon Kind="ScaleBalance" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Cal. Bat" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Commands Scroll Cards List -->
                            <Border Grid.Row="1" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                        <materialDesign:PackIcon Kind="Alert" Width="18" Height="18" Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Siren Commands Activation" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Wrap panel for cards -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding CommandCards}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="190" Height="150" Style="{StaticResource CommandCardStyle}"
                                                            Background="{Binding ColorLightBg}" BorderBrush="{Binding ColorHex}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*" />    <!-- Name & Info -->
                                                                <RowDefinition Height="Auto" /> <!-- Activate Button -->
                                                            </Grid.RowDefinitions>
                                                            
                                                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
                                                                <TextBlock Text="{Binding DurationDisplay, StringFormat='{}Duration: {0}'}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                            </StackPanel>

                                                            <Button Grid.Row="1" Background="White"
                                                                    BorderBrush="{Binding ColorForeground}" BorderThickness="1"
                                                                    Foreground="{Binding ColorForeground}"
                                                                    materialDesign:ButtonAssist.CornerRadius="5"
                                                                    FontWeight="Bold" FontSize="12" Height="34"
                                                                    Command="{Binding DataContext.ActivateCommandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}">
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                    <materialDesign:PackIcon Kind="VolumeHigh" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{Binding ColorForeground}"/>
                                                                    <TextBlock Text="Activate" VerticalAlignment="Center" Foreground="{Binding ColorForeground}"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Loading Placeholder if SelectedSiren is null -->
                <Grid Visibility="{Binding SelectedSiren, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverted}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="InboxOutline" Width="48" Height="48" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="No sirens configured in the system." FontSize="14" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Floating Countdown & Stop Active Command Overlay -->
                <Grid Panel.ZIndex="10" Visibility="{Binding IsCommandRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <!-- Semi-transparent backdrop -->
                    <Border Background="#A0000000" CornerRadius="8" />

                    <!-- Active dialog card -->
                    <Border Width="450" Height="220" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1.5" CornerRadius="12" Padding="25" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="25" ShadowDepth="10" Opacity="0.5" Color="Black" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />    <!-- Title, status & progress -->
                                <RowDefinition Height="Auto" /> <!-- Cancel/Stop Button -->
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                                    <materialDesign:PackIcon Kind="AlertDecagram" Width="26" Height="26" Foreground="#EF4444" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding CommandToConfirmName}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="{Binding ActiveDurationDisplay}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                
                                <ProgressBar IsIndeterminate="True" Height="4" Foreground="#EF4444" Background="{StaticResource AppBackground}" BorderThickness="0" Margin="20,0"/>
                            </StackPanel>

                            <Button Grid.Row="1" Command="{Binding StopRunningCommandCommand}" Background="#EF4444" BorderBrush="Transparent" Foreground="White" Height="42" FontWeight="Bold" materialDesign:ButtonAssist.CornerRadius="6">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AlertOctagon" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Stop Command (Cancel)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
