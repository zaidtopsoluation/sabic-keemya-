<UserControl x:Class="Keemya.Frontend.Views.ServiceManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Keemya.Frontend.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1366">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <local:BoolToGreenBrushConverter x:Key="BoolToGreenBrushConverter"/>
        <local:StatusOkFailColorConverter x:Key="StatusOkFailColorConverter"/>
        <local:StatusOnOffColorConverter x:Key="StatusOnOffColorConverter"/>
        <local:StatusHexToBrushConverter x:Key="StatusHexToBrushConverter"/>
        <local:StatusWithDataConverter x:Key="StatusWithDataConverter"/>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Back Button -->
        <StackPanel Grid.Row="0" Margin="25,15,25,10">
            <Button Command="{Binding BackCommand}" HorizontalAlignment="Left" Background="White" BorderBrush="#E2E8F0" Foreground="#1E293B" Padding="15,8" Style="{StaticResource MaterialDesignFlatButton}" materialDesign:ButtonAssist.CornerRadius="6">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource BackToModules}" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Row 1: Title -->
        <Grid Grid.Row="1" Margin="25,0,25,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Service Management" FontSize="26" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4" />
                <TextBlock Text="Operational diagnostics, SI status inspection, and siren service controls" FontSize="13" Foreground="#64748B" />
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding SiTestAllSelectedCommand}" Background="#1D4ED8" BorderBrush="Transparent" Foreground="White" Padding="18,0" Height="40" materialDesign:ButtonAssist.CornerRadius="8" FontWeight="Bold" FontSize="13" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="PlayCircleOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="SI Test All Sirens" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Row 2: Split Layout -->
        <Grid Grid.Row="2" Margin="25,0,25,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── LEFT: Siren List ── -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.04" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Siren Devices" FontSize="17" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <Border Background="#EFF6FF" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Sirens.Count, StringFormat='{}{0} Total'}" FontSize="11.5" FontWeight="Bold" Foreground="#2563EB"/>
                        </Border>
                    </Grid>
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="Transparent" BorderThickness="0" FontSize="12.5" Foreground="#0F172A"
                                     materialDesign:HintAssist.Hint="Search sirens..." materialDesign:HintAssist.Foreground="#94A3B8"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding FilteredSirens}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="2" CornerRadius="10" Padding="12,10" Margin="0,0,0,10" Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#1D4ED8"/>
                                                        <Setter Property="Background" Value="#EFF6FF"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F8FAFC"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.ClickSirenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="36" Height="36" Background="#EFF6FF" CornerRadius="18" Margin="0,0,10,0">
                                                <materialDesign:PackIcon Kind="VolumeHigh" Width="18" Height="18" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                                                <TextBlock Text="{Binding Subtext}" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Width="10" Height="10" CornerRadius="5" Background="{Binding StatusColorBrush, Converter={StaticResource StatusHexToBrushConverter}}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ── RIGHT: DEVICE STATUS Panel ── -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.04" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Siren Header & SI Test button -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="42" Height="42" Background="#EFF6FF" CornerRadius="21" Margin="0,0,12,0">
                            <materialDesign:PackIcon Kind="VolumeHigh" Width="22" Height="22" Foreground="#1D4ED8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedSiren.Name, FallbackValue='Select a Siren'}" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="{Binding SelectedSiren.Subtext, FallbackValue='Area Code &amp; Address Code'}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding SiTestSingleSirenCommand}" CommandParameter="{Binding SelectedSiren}"
                                Background="#1D4ED8" BorderBrush="Transparent" Foreground="White" Padding="16,0" Height="38"
                                materialDesign:ButtonAssist.CornerRadius="6" FontWeight="Bold" FontSize="13">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PlayCircleOutline" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="SI Test" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Divider -->
                    <Border Grid.Row="1" Height="1" Background="#F1F5F9" Margin="0,0,0,20"/>

                    <!-- DEVICE STATUS CARD -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Title bar -->
                            <Border Background="#D1D5DB" BorderBrush="#9CA3AF" BorderThickness="1" CornerRadius="6,6,0,0" Padding="16,10">
                                <Grid>
                                    <TextBlock Text="{Binding SelectedSiren.Name, FallbackValue='Select a Siren'}" FontSize="14.5" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                    <!-- Testing spinner -->
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Visibility="{Binding IsTestingInProgress, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <materialDesign:PackIcon Kind="Loading" Width="16" Height="16" Foreground="#374151" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Running SI Test..." FontSize="12" Foreground="#374151" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- DEVICE STATUS body -->
                            <Border Background="#E5E7EB" BorderBrush="#9CA3AF" BorderThickness="1,0,1,1" CornerRadius="0,0,6,6" Padding="20,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- ── COL 0: Status (single big dot) ── -->
                                    <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                                        <TextBlock Text="Status" Foreground="#1F2937" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Border Width="24" Height="24" CornerRadius="4" VerticalAlignment="Center">
                                            <Border.Background>
                                                <MultiBinding Converter="{StaticResource StatusWithDataConverter}">
                                                    <Binding Path="HealthLink"/>
                                                    <Binding Path="HasSiTestData"/>
                                                </MultiBinding>
                                            </Border.Background>
                                        </Border>
                                    </StackPanel>

                                    <!-- ── COL 2: Activity / Link / Radio ── -->
                                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="Activity" Foreground="#1F2937" FontSize="13.5" FontWeight="SemiBold" Width="70" VerticalAlignment="Center"/>
                                        <Border Width="24" Height="24" CornerRadius="4" VerticalAlignment="Center">
                                            <Border.Background>
                                                <MultiBinding Converter="{StaticResource StatusWithDataConverter}">
                                                    <Binding Path="HealthActivity"/>
                                                    <Binding Path="HasSiTestData"/>
                                                </MultiBinding>
                                            </Border.Background>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="Link" Foreground="#1F2937" FontSize="13.5" FontWeight="SemiBold" Width="70" VerticalAlignment="Center"/>
                                        <Border Width="24" Height="24" CornerRadius="4" VerticalAlignment="Center">
                                            <Border.Background>
                                                <MultiBinding Converter="{StaticResource StatusWithDataConverter}">
                                                    <Binding Path="HealthLink"/>
                                                    <Binding Path="HasSiTestData"/>
                                                </MultiBinding>
                                            </Border.Background>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,0">
                                        <TextBlock Text="Radio" Foreground="#6B7280" FontSize="13.5" FontWeight="SemiBold" Width="70" VerticalAlignment="Center"/>
                                        <!-- Radio: RS232/Serial siren has no radio transceiver → always N/A (grey) -->
                                        <Border Width="24" Height="24" CornerRadius="4" Background="#9CA3AF" VerticalAlignment="Center">
                                            <TextBlock Text="—" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- ── COL 4: AC / DC / Voltage / InfoTime ── -->
                                    <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="AC" Foreground="#1F2937" FontSize="13.5" FontWeight="SemiBold" Width="44" VerticalAlignment="Center"/>
                                        <Border Width="24" Height="24" CornerRadius="4" VerticalAlignment="Center">
                                            <Border.Background>
                                                <MultiBinding Converter="{StaticResource StatusWithDataConverter}">
                                                    <Binding Path="HealthAcOn"/>
                                                    <Binding Path="HasSiTestData"/>
                                                </MultiBinding>
                                            </Border.Background>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="DC" Foreground="#1F2937" FontSize="13.5" FontWeight="SemiBold" Width="44" VerticalAlignment="Center"/>
                                        <Border Width="24" Height="24" CornerRadius="4" VerticalAlignment="Center">
                                            <Border.Background>
                                                <MultiBinding Converter="{StaticResource StatusWithDataConverter}">
                                                    <Binding Path="HealthSystemPowerUp"/>
                                                    <Binding Path="HasSiTestData"/>
                                                </MultiBinding>
                                            </Border.Background>
                                        </Border>
                                    </StackPanel>

                                    <!-- Voltage -->
                                    <Grid Grid.Row="2" Grid.Column="4" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Voltage" Foreground="#1F2937" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="White" BorderBrush="#9CA3AF" BorderThickness="1" CornerRadius="3" Padding="8,4" MinWidth="80">
                                            <TextBlock Text="{Binding HealthDcVoltage, StringFormat='{}{0:F1}V', FallbackValue='--'}" Foreground="Black" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <!-- Info Time -->
                                    <Grid Grid.Row="3" Grid.Column="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Info Time" Foreground="#1F2937" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="White" BorderBrush="#9CA3AF" BorderThickness="1" CornerRadius="3" Padding="8,4" MinWidth="140">
                                            <TextBlock Text="{Binding LastTestTimestamp}" Foreground="Black" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <!-- ── COL 6: Intrusion / DRV/AMP ── -->
                                    <StackPanel Grid.Row="0" Grid.Column="6" Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="Intrusion" Foreground="#1F2937" FontSize="13.5" FontWeight="SemiBold" Width="78" VerticalAlignment="Center"/>
                                        <Border Width="24" Height="24" CornerRadius="4" VerticalAlignment="Center">
                                            <Border.Background>
                                                <!-- Intrusion: true=detected(BAD)=RED, false=clear(GOOD)=GREEN → invert -->
                                                <MultiBinding Converter="{StaticResource StatusWithDataConverter}" ConverterParameter="invert">
                                                    <Binding Path="HealthIntrusion"/>
                                                    <Binding Path="HasSiTestData"/>
                                                </MultiBinding>
                                            </Border.Background>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="6" Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="DRV/AMP" Foreground="#1F2937" FontSize="13.5" FontWeight="SemiBold" Width="78" VerticalAlignment="Center"/>
                                        <Border Width="24" Height="24" CornerRadius="4" VerticalAlignment="Center">
                                            <Border.Background>
                                                <MultiBinding Converter="{StaticResource StatusWithDataConverter}">
                                                    <Binding Path="HealthBiasDetected"/>
                                                    <Binding Path="HasSiTestData"/>
                                                </MultiBinding>
                                            </Border.Background>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
