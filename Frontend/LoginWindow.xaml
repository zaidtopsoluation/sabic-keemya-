<Window x:Class="Keemya.Frontend.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Keemya.Frontend"
        xmlns:viewmodels="clr-namespace:Keemya.Frontend.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Login - TS Keemya" Height="768" Width="1366"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/logo.png">

    <Window.DataContext>
        <viewmodels:LoginViewModel />
    </Window.DataContext>

    <!-- Main Background -->
    <Grid Background="{StaticResource AppBackground}">
        
        <!-- Centered Floating Login Card -->
        <Border Width="900" Height="500" CornerRadius="12" Background="{StaticResource CardBackground}" 
                BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="10" Opacity="0.4" Color="Black" />
            </Border.Effect>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Language Toggle in Login Window -->
                <Button Command="{Binding ToggleLanguageCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20" Background="#1E293B" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Foreground="{StaticResource TextPrimary}" Padding="10,4" Height="Auto" Cursor="Hand" Panel.ZIndex="10">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Translate" Width="14" Height="14" Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding CurrentLanguageText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#334155" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Left Side: Forms Container -->
                <Grid Grid.Column="0" Margin="50">
                    
                    <!-- 1. Normal Login Form -->
                    <StackPanel VerticalAlignment="Center" Visibility="{Binding LoginFormVisibility}">
                        <!-- Logo & Title -->
                        <Image Source="/Assets/logo.png" Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,15" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="{DynamicResource LoginTitle}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,5" />
                        <TextBlock Text="{DynamicResource LoginSubtitle}" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,30" />

                        <!-- Error Message -->
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" Margin="0,0,0,10" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" TextWrapping="Wrap" />

                        <!-- Username -->
                        <TextBlock Text="{DynamicResource Username}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Background="{StaticResource AppBackground}" Padding="10,5" Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountOutline" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Foreground="{StaticResource TextPrimary}" Background="Transparent" BorderThickness="0" Width="250" materialDesign:HintAssist.Hint="Enter username" materialDesign:HintAssist.Foreground="{StaticResource TextSecondary}" CaretBrush="White" />
                            </StackPanel>
                        </Border>

                        <!-- Password -->
                        <TextBlock Text="{DynamicResource Password}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Background="{StaticResource AppBackground}" Padding="10,5" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <materialDesign:PackIcon Grid.Column="0" Kind="LockOutline" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                
                                <PasswordBox x:Name="txtPassword" Grid.Column="1" Foreground="{StaticResource TextPrimary}" Background="Transparent" BorderThickness="0" materialDesign:HintAssist.Hint="••••••••" materialDesign:HintAssist.Foreground="{StaticResource TextSecondary}" CaretBrush="White" PasswordChanged="txtPassword_PasswordChanged" />
                                <TextBox x:Name="txtVisiblePassword" Grid.Column="1" Foreground="{StaticResource TextPrimary}" Background="Transparent" BorderThickness="0" materialDesign:HintAssist.Hint="Enter password" materialDesign:HintAssist.Foreground="{StaticResource TextSecondary}" CaretBrush="White" Visibility="Collapsed" TextChanged="txtVisiblePassword_TextChanged" />
                                
                                <Button x:Name="btnTogglePassword" Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Click="btnTogglePassword_Click">
                                    <materialDesign:PackIcon x:Name="iconTogglePassword" Kind="EyeOutline" Foreground="{StaticResource TextSecondary}" Width="18" Height="18" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Sign In Button -->
                        <Button Content="{DynamicResource SignIn}" Command="{Binding LoginCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Background="#6366F1" BorderBrush="Transparent" Foreground="White" FontWeight="Bold" Padding="0,10" Cursor="Hand" IsDefault="True">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#4F46E5" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- 2. First-Time Password Change Form -->
                    <StackPanel VerticalAlignment="Center" Visibility="{Binding ChangePasswordFormVisibility}">
                        <!-- Shield & Key Icon -->
                        <materialDesign:PackIcon Kind="ShieldKeyOutline" Width="48" Height="48" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                        <TextBlock Text="{DynamicResource ChangePassword}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,5" />
                        <TextBlock Text="{DynamicResource FirstTimeLoginPrompt}" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,25" />

                        <!-- Error/Instruction Message -->
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" Margin="0,0,0,15" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />

                        <!-- New Password -->
                        <TextBlock Text="{DynamicResource NewPassword}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Background="{StaticResource AppBackground}" Padding="10,5" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <materialDesign:PackIcon Grid.Column="0" Kind="LockPlusOutline" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                
                                <PasswordBox x:Name="txtNewPassword" Grid.Column="1" Foreground="{StaticResource TextPrimary}" Background="Transparent" BorderThickness="0" materialDesign:HintAssist.Hint="••••••••" materialDesign:HintAssist.Foreground="{StaticResource TextSecondary}" CaretBrush="White" PasswordChanged="txtNewPassword_PasswordChanged" />
                                <TextBox x:Name="txtVisibleNewPassword" Grid.Column="1" Foreground="{StaticResource TextPrimary}" Background="Transparent" BorderThickness="0" materialDesign:HintAssist.Hint="Enter password" materialDesign:HintAssist.Foreground="{StaticResource TextSecondary}" CaretBrush="White" Visibility="Collapsed" TextChanged="txtVisibleNewPassword_TextChanged" />
                                
                                <Button x:Name="btnToggleNewPassword" Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Click="btnToggleNewPassword_Click">
                                    <materialDesign:PackIcon x:Name="iconToggleNewPassword" Kind="EyeOutline" Foreground="{StaticResource TextSecondary}" Width="18" Height="18" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Confirm New Password -->
                        <TextBlock Text="{DynamicResource ConfirmNewPassword}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Background="{StaticResource AppBackground}" Padding="10,5" Margin="0,0,0,25">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <materialDesign:PackIcon Grid.Column="0" Kind="LockCheckOutline" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                
                                <PasswordBox x:Name="txtConfirmPassword" Grid.Column="1" Foreground="{StaticResource TextPrimary}" Background="Transparent" BorderThickness="0" materialDesign:HintAssist.Hint="••••••••" materialDesign:HintAssist.Foreground="{StaticResource TextSecondary}" CaretBrush="White" PasswordChanged="txtConfirmPassword_PasswordChanged" />
                                <TextBox x:Name="txtVisibleConfirmPassword" Grid.Column="1" Foreground="{StaticResource TextPrimary}" Background="Transparent" BorderThickness="0" materialDesign:HintAssist.Hint="Confirm password" materialDesign:HintAssist.Foreground="{StaticResource TextSecondary}" CaretBrush="White" Visibility="Collapsed" TextChanged="txtVisibleConfirmPassword_TextChanged" />
                                
                                <Button x:Name="btnToggleConfirmPassword" Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Click="btnToggleConfirmPassword_Click">
                                    <materialDesign:PackIcon x:Name="iconToggleConfirmPassword" Kind="EyeOutline" Foreground="{StaticResource TextSecondary}" Width="18" Height="18" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Submit Change Button -->
                        <Button Content="{DynamicResource UpdateAndLogin}" Command="{Binding ChangePasswordCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Background="#10B981" BorderBrush="Transparent" Foreground="White" FontWeight="Bold" Padding="0,10" Cursor="Hand" IsDefault="True">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#059669" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    
                </Grid>

                <!-- Right Side: Image -->
                <Border Grid.Column="1" CornerRadius="0,12,12,0" ClipToBounds="True">
                    <Image Source="/Assets/image.png" Stretch="UniformToFill" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
