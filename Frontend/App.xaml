<Application x:Class="Keemya.Frontend.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Keemya.Frontend"
             xmlns:viewmodels="clr-namespace:Keemya.Frontend.ViewModels"
             xmlns:views="clr-namespace:Keemya.Frontend.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Custom Color Palette -->
            <SolidColorBrush x:Key="AppBackground" Color="#F4F5F9" />
            <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardBorder" Color="#E2E8F0" />
            <SolidColorBrush x:Key="TextPrimary" Color="#1E293B" />
            <SolidColorBrush x:Key="TextSecondary" Color="#64748B" />
            <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6" />
            <SolidColorBrush x:Key="AccentGreen" Color="#10B981" />
            
            <Style TargetType="Window" x:Key="CustomWindowStyle">
                <Setter Property="Background" Value="{StaticResource AppBackground}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
            </Style>
            
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <!-- iOS / Clean Circular Toggle Switch Style -->
            <Style TargetType="ToggleButton" x:Key="CleanSwitchStyle">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Track" CornerRadius="12" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1">
                                <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect ShadowDepth="1" Direction="270" Opacity="0.2" BlurRadius="2"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="#3B82F6"/>
                                    <Setter TargetName="Track" Property="BorderBrush" Value="#3B82F6"/>
                                    <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                                    <Setter TargetName="Thumb" Property="Margin" Value="21,0,0,0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- KPI Card Style -->
            <Style TargetType="Border" x:Key="KpiCardStyle">
                <Setter Property="Background" Value="{StaticResource CardBackground}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Margin" Value="10" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <!-- Module Card Style -->
            <Style TargetType="Button" x:Key="ModuleCardStyle">
                <Setter Property="Background" Value="{StaticResource CardBackground}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                <Setter Property="Margin" Value="10" />
                <Setter Property="Padding" Value="20" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F1F5F9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ViewModel to View Mappings -->
            <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type viewmodels:UserManagementViewModel}">
                <views:UserManagementView />
            </DataTemplate>


            <DataTemplate DataType="{x:Type viewmodels:ProfileViewModel}">
                <views:ProfileView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewmodels:SirenManagementViewModel}">
                <views:SirenManagementView />
            </DataTemplate>


            <DataTemplate DataType="{x:Type viewmodels:CommandCenterViewModel}">
                <views:CommandCenterView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewmodels:MapViewModel}">
                <views:MapView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewmodels:AuditLogsViewModel}">
                <views:AuditLogsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewmodels:NotificationsViewModel}">
                <views:NotificationsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewmodels:ServiceManagementViewModel}">
                <views:ServiceManagementView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>

