<Window x:Class="Keemya.Frontend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Keemya.Frontend"
        xmlns:viewmodels="clr-namespace:Keemya.Frontend.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Emergency Management System" Height="768" Width="1366"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource CustomWindowStyle}"
        Icon="Assets/logo.png">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="{Binding MainGridMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header (Fixed at the top of the window across all modules) -->
        <Grid Grid.Row="0" Margin="0,0,0,30" Visibility="{Binding IsHeaderVisible, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Logo and Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Image Source="/Assets/logo.png" Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,15,0" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource AppTitle}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="{DynamicResource AppSubtitle}" FontSize="14" Foreground="{StaticResource TextSecondary}" />
                </StackPanel>
            </StackPanel>

            <!-- User Info and Actions -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Premium Language Toggle -->
                <Button Command="{Binding ToggleLanguageCommand}" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Foreground="{StaticResource TextPrimary}" Margin="0,0,20,0" Padding="12,5" Height="Auto" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Translate" Width="16" Height="16" Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding CurrentLanguageText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F1F5F9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Clickable Notification Bell with Badge -->
                <Grid Margin="0,0,30,0" VerticalAlignment="Center">
                    <Button Command="{Binding NavigateToNotificationsCommand}" Background="Transparent" BorderBrush="Transparent" Padding="4" Height="Auto" Width="Auto" Cursor="Hand" Style="{StaticResource MaterialDesignFlatButton}">
                        <materialDesign:PackIcon Kind="BellOutline" Width="20" Height="20" Foreground="{StaticResource TextSecondary}" />
                    </Button>
                    <Border Background="#EF4444" CornerRadius="8" MinWidth="16" Height="16" 
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,2,0" Padding="3,0,3,0" IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UnreadNotificationsCount}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding UnreadNotificationsCount}" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                
                <Border Background="{StaticResource AccentBlue}" CornerRadius="15" Width="30" Height="30" Margin="0,0,10,0">
                    <TextBlock Text="AD" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                </Border>
                <TextBlock Text="{Binding CurrentUsername}" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,15,0" />
                
                <Button Background="Transparent" BorderBrush="Transparent" Padding="0" Cursor="Hand" 
                        Command="{Binding LogoutCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                    <materialDesign:PackIcon Kind="Logout" Width="20" Height="20" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Active View / Content Area -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
